#!/usr/bin/env python3
"""Test helper for contrib/e2e-sway.

    grim -t ppm - | ppm-pixel [X Y]     print the pixel at (X, Y) as "r g b" (default: centre)
    ppm-pixel --write-test-png PATH     write a 64x64 PNG, top half red, bottom half blue
"""

import struct
import sys
import zlib


def pixel(args):
    data = sys.stdin.buffer.read()
    parts, i = [], 0
    while len(parts) < 4:
        while data[i : i + 1].isspace():
            i += 1
        j = i
        while not data[j : j + 1].isspace():
            j += 1
        parts.append(data[i:j])
        i = j
    i += 1
    w, h = int(parts[1]), int(parts[2])
    x = int(args[0]) if args else w // 2
    y = int(args[1]) if len(args) > 1 else h // 2
    o = i + (y * w + x) * 3
    print(*data[o : o + 3])


def write_test_png(path):
    # Large enough that bilinear filtering only blends the few rows at the seam.
    rows = [bytes([0] + [255, 0, 0] * 64)] * 32 + [bytes([0] + [0, 0, 255] * 64)] * 32

    def chunk(tag, body):
        return struct.pack(">I", len(body)) + tag + body + struct.pack(">I", zlib.crc32(tag + body))

    png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", 64, 64, 8, 2, 0, 0, 0))
    png += chunk(b"IDAT", zlib.compress(b"".join(rows))) + chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)


if __name__ == "__main__":
    if sys.argv[1:2] == ["--write-test-png"]:
        write_test_png(sys.argv[2])
    else:
        pixel(sys.argv[1:])
