#!/usr/bin/env python3
"""Image fixture and pixel helper for the headless-sway end-to-end tests.

    grim -t ppm - | ppm-pixel [X Y]     print the pixel at (X, Y) as "r g b" (default: centre)
    ppm-pixel --write-test-png PATH     write a 64x64 PNG, top half red, bottom half blue
    ppm-pixel --write-quadrant-png PATH write red/green above blue/white
"""

import struct
import sys
import zlib


def fail(msg):
    print(f"ppm-pixel: {msg}", file=sys.stderr)
    sys.exit(1)


def pixel(args):
    data = sys.stdin.buffer.read()
    # Header: "P6", width, height, maxval, each separated by whitespace, then one whitespace byte.
    parts, i = [], 0
    while len(parts) < 4:
        while i < len(data) and data[i : i + 1].isspace():
            i += 1
        j = i
        while j < len(data) and not data[j : j + 1].isspace():
            j += 1
        if j == i:
            fail("empty or truncated PPM header")
        parts.append(data[i:j])
        i = j
    i += 1
    if parts[0] != b"P6" or not (parts[1].isdigit() and parts[2].isdigit()):
        fail("not a binary PPM (P6)")
    w, h = int(parts[1]), int(parts[2])
    x = int(args[0]) if args else w // 2
    y = int(args[1]) if len(args) > 1 else h // 2
    if not (0 <= x < w and 0 <= y < h):
        fail(f"pixel ({x}, {y}) is outside the {w}x{h} image")
    o = i + (y * w + x) * 3
    if o + 3 > len(data):
        fail("truncated PPM pixel data")
    print(*data[o : o + 3])


def write_test_png(path, quadrants=False):
    # Large enough that bilinear filtering only blends the few rows at the seam.
    if quadrants:
        rows = ([bytes([0] + [255, 0, 0] * 32 + [0, 255, 0] * 32)] * 32
                + [bytes([0] + [0, 0, 255] * 32 + [255, 255, 255] * 32)] * 32)
    else:
        rows = [bytes([0] + [255, 0, 0] * 64)] * 32 + [bytes([0] + [0, 0, 255] * 64)] * 32

    def chunk(tag, body):
        return struct.pack(">I", len(body)) + tag + body + struct.pack(">I", zlib.crc32(tag + body))

    png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", 64, 64, 8, 2, 0, 0, 0))
    png += chunk(b"IDAT", zlib.compress(b"".join(rows))) + chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)


if __name__ == "__main__":
    if sys.argv[1:2] in (["--write-test-png"], ["--write-quadrant-png"]):
        write_test_png(sys.argv[2], sys.argv[1] == "--write-quadrant-png")
    else:
        pixel(sys.argv[1:])
