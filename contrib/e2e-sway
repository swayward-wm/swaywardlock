t_field_overshoot() {
    # The most overshoot validate allows on the dots: retargeting mid-animation used to compound
    # it (cubic-bezier y 1000 wedged the main thread in the dot loop, so the password never
    # landed). Keys 100 ms apart, then the password unlocks. OVERSHOOT_Y overrides the curve's
    # y (a build without validate's bezier check takes 1000).
    local y=${OVERSHOOT_Y:-3}
    cat >"$XDG_RUNTIME_DIR/lock.kdl" <<EOF
background { color "#000000"; }
animations {
    input-field-dots { duration-ms 300; curve "cubic-bezier" 0 $y 1 $y; }
    input-field-width { duration-ms 300; curve "cubic-bezier" 0 -2 1 $y; }
}
input-field { size 200 50; fade-on-empty false; placeholder-text "wwwwwwwwwwww"; }
EOF
    [ -n "${OVERSHOOT_CONTROL:-}" ] && sed -i '/cubic-bezier/d' "$XDG_RUNTIME_DIR/lock.kdl"
    start_field "field-overshoot" || return
    $T wtype -s 300 -d 100 abcdef
    sleep 0.5
    $T wtype -s 300 -k Escape
    sleep 0.5
    # Key then Backspace, over and over: the width retargets between the field and the
    # placeholder width on every key.
    local args=(-s 300) i
    for i in $(seq 20); do args+=(x -s 100 -k BackSpace -s 100); done
    $T wtype "${args[@]}"
    sleep 0.5
    # Each wtype run creates a fresh virtual keyboard; give the locker time to bind it.
    $T wtype -s 300 -d 100 "$PASSWORD" -k Return
    wait_exit "$pid"
    check "field-overshoot: password unlocks after overshooting retargets" "$?" 0
}

t_ring_overshoot() {
    # The swayward ring's highlight, trail, appear and wrong animations share the input field's
    # Var: with the most overshoot validate allows, fast keys (each retargets the highlight
    # mid-overshoot) and a wrong password keep the locker responsive, and the password unlocks.
    # OVERSHOOT_Y overrides the curve's y (a build without validate's bezier check takes 1000).
    local y=${OVERSHOOT_Y:-3}
    ring_style_conf "animations {
    ring-highlight { duration-ms 300; curve \"cubic-bezier\" 0 $y 1 $y; }
    ring-wrong { duration-ms 300; curve \"cubic-bezier\" 0 $y 1 -2; }
    ring-appear { duration-ms 300; curve \"cubic-bezier\" 0 -2 1 $y; }
}"
    start_field "ring-overshoot" || return
    $T wtype -s 300 -d 50 abcdefghijklmnopqrstuvwxyz -k Return
    sleep 1
    kill -0 "$pid" 2>/dev/null && pass "ring-overshoot: still locked after a wrong password" \
        || fail "ring-overshoot: exited after a wrong password"
    $T wtype -s 300 -d 50 abcdefghijklmnopqrstuvwxyz -k Escape
    sleep 0.5
    local t0 ms
    t0=$(date +%s%N)
    $T wtype -s 300 -d 50 "$PASSWORD" -k Return
    wait_exit "$pid"
    check "ring-overshoot: password unlocks after overshooting retargets" "$?" 0
    ms=$(( ($(date +%s%N) - t0) / 1000000 ))
    [ "$ms" -lt 5000 ] && pass "ring-overshoot: typed and unlocked in ${ms} ms" \
        || fail "ring-overshoot: typing the password took ${ms} ms"
}

t_field_width() {
    cat >"$XDG_RUNTIME_DIR/lock.kdl" <<'EOF'
background { color "#000000"; }
animations { input-field-width { duration-ms 2000; curve "linear"; }; }
input-field {
    size 100 40
    inner-color "#ffffff"
    font-color "#000000"
    outline { width 4; color "#0000ff"; }
    placeholder-text "wwwwwwwwwwwwwwww"
    fade-on-empty false
}
EOF
    [ -n "${FIELD_BASE:-}" ] && sed -i '/^animations/d' "$XDG_RUNTIME_DIR/lock.kdl"
    start_field "field-width" || return
    local t0 mid final back
    t0=$(date +%s%N)
    sleep_until "$t0" 1000
    mid=$(white_width)
    sleep_until "$t0" 3000
    final=$(white_width)
    { [ "$final" -gt 130 ] && [ "$final" -lt 300 ]; } \
        && pass "field-width: grows for the placeholder (100 -> ${final}px)" \
        || fail "field-width: final width ${final}px"
    { [ "$mid" -gt 100 ] && [ "$mid" -lt "$final" ]; } && pass "field-width: partway at ~1 s (${mid}px)" \
        || fail "field-width: not mid-animation at ~1 s (${mid}px of ${final}px)"
    # Typing removes the placeholder: back to the configured width.
    $T wtype -s 300 a
    t0=$(date +%s%N)
    sleep_until "$t0" 1000
    mid=$(white_width)
    sleep_until "$t0" 3000
    back=$(white_width)
    { [ "$mid" -gt 100 ] && [ "$mid" -lt "$final" ]; } && pass "field-width: shrinking at ~1 s (${mid}px)" \
        || fail "field-width: not mid-shrink at ~1 s (${mid}px)"
    check "field-width: back to 100 px after typing" "$back" 100
    kill -USR1 "$pid"
    wait_exit "$pid"
}

# A field animation never delays the unlock, and never unlocks by itself.
t_field_unlock() {
    cat >"$XDG_RUNTIME_DIR/lock.kdl" <<'EOF'
background { color "#000000"; }
animations {
    fade-out { duration-ms 800; curve "linear"; }
    input-field-width { duration-ms 3000; curve "linear"; }
}
input-field {
    size 100 40
    inner-color "#ffffff"
    font-color "#000000"
    outline { width 4; color "#0000ff"; }
    placeholder-text "wwwwwwwwwwwwwwww"
    fade-on-empty false
}
EOF
    start_field "field-unlock" || return
    sleep 1
    local w1 w2 t0 t1 ms
    w1=$(white_width)
    sleep 0.5
    w2=$(white_width)
    # Still growing: a field animation is running when the signal arrives.
    { [ "$w1" -gt 100 ] && [ "$w2" -gt "$w1" ]; } \
        && pass "field-unlock: a field animation is running (${w1} -> ${w2}px)" \
        || fail "field-unlock: field animation not running (${w1} -> ${w2}px)"
    t0=$(date +%s%N)
    kill -USR1 "$pid"
    wait_exit "$pid"
    check "field-unlock: exit code" "$?" 0
    t1=$(date +%s%N)
    ms=$(( (t1 - t0) / 1000000 ))
    { [ "$ms" -ge 750 ] && [ "$ms" -le 1800 ]; } \
        && pass "field-unlock: unlock took the fade-out, not the field (${ms} ms)" \
        || fail "field-unlock: unlock took ${ms} ms (fade-out 800 ms, width animation 3000 ms)"

    # The animations finishing never unlocks the session: still locked after a wrong password
    # and ordinary typing, once everything has settled.
    cat >"$XDG_RUNTIME_DIR/lock.kdl" <<'EOF'
background { color "#000000"; }
animations {
    input-field-width { duration-ms 1000; }
    input-field-colors { duration-ms 1000; }
    input-field-dots { duration-ms 1000; }
}
input-field { placeholder-text "wwwwwwwwwwwwwwww"; fade-on-empty timeout-ms=500; }
EOF
    start_field "field-unlock" || return
    $T wtype -s 300 abc -k Return
    sleep 2.5
    kill -0 "$pid" 2>/dev/null && pass "field-unlock: still locked after a wrong password and its animations" \
        || fail "field-unlock: exited after a wrong password"
    $T wtype -s 300 abc
    sleep 2.5
    kill -0 "$pid" 2>/dev/null && pass "field-unlock: still locked after typing and its animations" \
        || fail "field-unlock: exited after typing"
    kill -USR1 "$pid"
    wait_exit "$pid"
}

# Start a screenshot lock on $XDG_RUNTIME_DIR/lock.kdl with its own debug log, so the capture
# backend it picked can be asserted. Sets pid and SHOTLOG. Usage: lock_shot NAME [HOOK]
# HOOK sets SWAYWARDLOCK_TEST_SCREENCOPY: ext (skip wlr), none (skip both), ext-fail.
lock_shot() {
    SHOTLOG="${KEEP_LOGS:-$XDG_RUNTIME_DIR}/lock-shot-$1.log"
    env ${2:+SWAYWARDLOCK_TEST_SCREENCOPY=$2} RUST_LOG=swaywardlock=debug \
        "$BIN" --no-fade-in -c "$XDG_RUNTIME_DIR/lock.kdl" >"$SHOTLOG" 2>&1 &
    pid=$!
    wait_locked "$SHOTLOG"
}

# Check that the last lock_shot log has a line. Usage: check_log NAME TEXT
check_log() {
    if grep -q "$2" "$SHOTLOG"; then pass "$1"; else fail "$1 (no '$2' in $SHOTLOG)"; fi
}

t_screenshot() {
    # swaybg paints the desktop magenta; the lock's screenshot background must show it.
    swaybg -c '#ff00ff' >/dev/null 2>&1 &
    local bg=$! pid
    for _ in $(seq 30); do
        [ "$(pixel 5 5)" = "255 0 255" ] && break
        sleep 0.1
    done
    check "screenshot: desktop is magenta before locking" "$(pixel 5 5)" "255 0 255"
    printf '%s\n' 'background { color "#204060"; screenshot; }' >"$XDG_RUNTIME_DIR/lock.kdl"
    lock_shot wlr || { fail "screenshot: never locked"; cat "$SHOTLOG"; kill "$pid" "$bg"; return; }
    check_log "screenshot: wlr-screencopy is tried first" "screenshots via wlr-screencopy"
    check_colour "screenshot: lock shows the desktop" "255 0 255" 160 120
    kill -USR1 "$pid"
    wait_exit "$pid"

    # Without wlr-screencopy, ext-image-copy-capture takes the screenshot.
    lock_shot ext ext || { fail "screenshot: ext never locked"; cat "$SHOTLOG"; kill "$pid" "$bg"; return; }
    check_log "screenshot: ext-image-copy-capture is the fallback" "screenshots via ext-image-copy-capture"
    check_colour "screenshot: ext-image-copy-capture shows the desktop" "255 0 255" 160 120
    kill -USR1 "$pid"
    wait_exit "$pid"

    # With neither, the colour shows and the session still locks.
    lock_shot none none || { fail "screenshot: none never locked"; cat "$SHOTLOG"; kill "$pid" "$bg"; return; }
    check_log "screenshot: no capture protocol is reported" "screenshots unavailable"
    check_colour "screenshot: no capture protocol falls back to the colour" "32 64 96" 160 120
    kill -USR1 "$pid"
    wait_exit "$pid"

    # A failed ext capture (a 1x1 buffer breaks the buffer constraints) falls back to the colour.
    lock_shot ext-fail ext-fail \
        || { fail "screenshot: ext-fail never locked"; cat "$SHOTLOG"; kill "$pid" "$bg"; return; }
    check_log "screenshot: failed ext capture is reported" "buffer_constraints"
    check_colour "screenshot: failed ext capture falls back to the colour" "32 64 96" 160 120
    kill -0 "$pid" 2>/dev/null && pass "screenshot: failed ext capture keeps the lock" \
        || fail "screenshot: exited after a failed ext capture"
    kill -USR1 "$pid"
    wait_exit "$pid"

    # --immediate-render skips the capture: the colour shows instead.
    "$BIN" --immediate-render -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "screenshot: immediate never locked"; kill "$pid" "$bg"; return; }
    check_colour "screenshot: --immediate-render falls back to the colour" "32 64 96" 160 120
    kill -USR1 "$pid"
    wait_exit "$pid"
    kill "$bg"
}

# Size of the output as grim sees it, "W H".
grim_size() {
    $T grim -t ppm - | python3 -c '
import sys
parts = sys.stdin.buffer.read(64).split()
print(int(parts[1]), int(parts[2]))'
}

# HEADLESS-1's transform as sway reports it ("normal", "90", "flipped-180", ...).
output_transform() {
    swaymsg_ -r -t get_outputs | python3 -c '
import json, sys
print(next(o["transform"] for o in json.load(sys.stdin) if o["name"] == "HEADLESS-1"))'
}

t_screenshot_rotation() {
    # Top red, bottom blue, stretched over the output in whatever orientation it has.
    python3 "$HERE/ppm-pixel" --write-test-png "$XDG_RUNTIME_DIR/bg.png"
    swaybg -i "$XDG_RUNTIME_DIR/bg.png" -m stretch >/dev/null 2>&1 &
    local bg=$! pid tf hook w h top bottom
    printf '%s\n' 'background { color "#204060"; screenshot; fit "fill"; }' \
        >"$XDG_RUNTIME_DIR/lock.kdl"
    for tf in 90 flipped-180; do
        swaymsg_ output HEADLESS-1 transform "$tf" >/dev/null
        # Wait until sway reports the transform and swaybg has redrawn the turned output (grim
        # shows the desktop upright: red on top, blue at the bottom).
        for _ in $(seq 30); do
            [ "$(output_transform)" = "$tf" ] && break
            sleep 0.1
        done
        for _ in $(seq 30); do
            read -r w h < <(grim_size)
            top=$(pixel $((w / 2)) 10)
            bottom=$(pixel $((w / 2)) $((h - 10)))
            { [ "$tf" != 90 ] || [ "$w" -lt "$h" ]; } && [ "$top $bottom" = "255 0 0 0 0 255" ] && break
            sleep 0.1
        done
        check "rotation $tf: desktop is red on top, blue below (${w}x${h})" "$top $bottom" \
            "255 0 0 0 0 255"
        for hook in wlr ext; do
            lock_shot "$tf-$hook" "${hook#wlr}" \
                || { fail "rotation $tf $hook: never locked"; cat "$SHOTLOG"; kill "$pid"; continue; }
            if [ "$hook" = ext ]; then
                check_log "rotation $tf: ext run uses ext-image-copy-capture" \
                    "screenshots via ext-image-copy-capture"
            else
                check_log "rotation $tf: default run uses wlr-screencopy" "screenshots via wlr-screencopy"
            fi
            check_colour "rotation $tf $hook: lock top matches the desktop" "$top" $((w / 2)) 10
            check_colour "rotation $tf $hook: lock bottom matches the desktop" "$bottom" \
                $((w / 2)) $((h - 10))
            kill -USR1 "$pid"
            wait_exit "$pid"
        done
        swaymsg_ output HEADLESS-1 transform normal >/dev/null
    done
    kill "$bg"
}

t_fade() {
    cat >"$XDG_RUNTIME_DIR/lock.kdl" <<'EOF'
background { color "#ffffff"; }
animations {
    fade-in { duration-ms 1500; curve "linear"; }
    fade-out { duration-ms 1500; curve "linear"; }
}
EOF
    "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "fade: never locked"; cat "$LOG"; kill "$pid"; return; }
    sleep 0.4
    local early late early2
    early=$(pixel 5 5 | cut -d' ' -f1)
    sleep 0.4
    early2=$(pixel 5 5 | cut -d' ' -f1)
    sleep 1.2
    late=$(pixel 5 5 | cut -d' ' -f1)
    { [ "$early" -gt 10 ] && [ "$early" -lt 240 ]; } && pass "fade: partway through fade-in ($early)" \
        || fail "fade: not mid-fade at 0.4 s ($early)"
    # From black to the lock screen, not the other way round.
    [ "$early2" -gt $((early + 20)) ] && pass "fade: fade-in brightens ($early -> $early2)" \
        || fail "fade: fade-in does not brighten ($early -> $early2)"
    check "fade: fully faded in" "$late" 255
    # Fade out: the unlock waits for the animation, and the screen darkens first.
    local t0 t1 mid
    t0=$(date +%s%N)
    kill -USR1 "$pid"
    sleep 0.6
    mid=$(pixel 5 5 | cut -d' ' -f1)
    wait_exit "$pid"
    t1=$(date +%s%N)
    { [ "$mid" -gt 10 ] && [ "$mid" -lt 240 ]; } && pass "fade: partway through fade-out ($mid)" \
        || fail "fade: not mid-fade-out at 0.6 s ($mid)"
    local ms=$(( (t1 - t0) / 1000000 ))
    { [ "$ms" -ge 1300 ] && [ "$ms" -lt 3500 ]; } && pass "fade: unlock waited for the fade-out (${ms} ms)" \
        || fail "fade: unlock took ${ms} ms"

    # A compositor may send `locked` after it has shown our first frame (test hook: act on it
    # 1.5 s late). The fade-in must not then restart from black over a lock screen already shown.
    SWAYWARDLOCK_TEST_LATE_LOCKED=1500 "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG.late" 2>&1 &
    local late_pid=$!
    sleep 1
    local before_locked after_locked
    before_locked=$(pixel 5 5 | cut -d' ' -f1)
    wait_locked "$LOG.late" || { fail "fade: late locked never arrived"; kill "$late_pid"; return; }
    after_locked=$(pixel 5 5 | cut -d' ' -f1)
    check "fade: late locked, lock screen shown before locked" "$before_locked" 255
    check "fade: late locked, no restart from black" "$after_locked" 255
    kill -USR1 "$late_pid"
    wait_exit "$late_pid"

    # An unlock in the middle of the fade-in fades out from the opacity reached, darker from the
    # first frame on; starting the fade-out from full opacity flashed the lock screen bright.
    printf '%s\n' 'background { color "#ffffff"; }' \
        'animations { fade-in { duration-ms 3000; curve "linear"; }; fade-out { duration-ms 1500; curve "linear"; }; }' \
        >"$XDG_RUNTIME_DIR/mid.kdl"
    "$BIN" -c "$XDG_RUNTIME_DIR/mid.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "fade: mid never locked"; kill "$pid"; return; }
    sleep 1.2
    local before after max=0 v
    before=$(pixel 5 5 | cut -d' ' -f1)
    kill -USR1 "$pid"
    for _ in 1 2 3 4 5; do
        v=$(pixel 5 5 | cut -d' ' -f1)
        [ "$v" -gt "$max" ] && max=$v
        sleep 0.1
    done
    after=$(pixel 5 5 | cut -d' ' -f1)
    { [ "$max" -le $((before + 25)) ] && [ "$after" -lt "$before" ]; } \
        && pass "fade: an unlock mid fade-in darkens from there ($before -> max $max -> $after)" \
        || fail "fade: an unlock mid fade-in brightened ($before -> max $max -> $after)"
    wait_exit "$pid"

    # --no-fade-in skips a configured fade-in.
    printf '%s\n' 'background { color "#ffffff"; }' 'animations { fade-in { duration-ms 3000; }; }' \
        >"$XDG_RUNTIME_DIR/nofade.kdl"
    "$BIN" --no-fade-in -c "$XDG_RUNTIME_DIR/nofade.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "fade: --no-fade-in never locked"; kill "$pid"; return; }
    sleep 0.5
    check "fade: --no-fade-in shows full colour at once" "$(pixel 5 5)" "255 255 255"
    kill -USR1 "$pid"
    wait_exit "$pid"

    # `animations { off }` draws at full opacity at once.
    printf '%s\n' 'background { color "#ffffff"; }' 'animations { off; }' >"$XDG_RUNTIME_DIR/off.kdl"
    "$BIN" -c "$XDG_RUNTIME_DIR/off.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "fade: off never locked"; kill "$pid"; return; }
    check_colour "fade: animations off shows full colour" "255 255 255" 5 5
    t0=$(date +%s%N)
    kill -USR1 "$pid"
    wait_exit "$pid"
    t1=$(date +%s%N)
    ms=$(( (t1 - t0) / 1000000 ))
    [ "$ms" -lt 1000 ] && pass "fade: animations off unlocks at once (${ms} ms)" \
        || fail "fade: animations off took ${ms} ms to unlock"

    # A zero-length fade-out must still unlock (it once left the session wedged locked).
    printf '%s\n' 'animations { fade-out { duration-ms 0; }; }' >"$XDG_RUNTIME_DIR/zero.kdl"
    "$BIN" -c "$XDG_RUNTIME_DIR/zero.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "fade: zero never locked"; kill "$pid"; return; }
    sleep 1 # let the default fade-in finish, so its ticker is not the one that unlocks
    kill -USR1 "$pid"
    wait_exit "$pid"
    check "fade: duration-ms 0 fade-out unlocks" "$?" 0

    # The password during a fade-in with fade-out off: the fade-in ticker once drew into the
    # destroyed lock surface after the unlock and blocked there, so the process never exited.
    printf '%s\n' 'background { color "#ffffff"; }' \
        'animations { fade-in { duration-ms 3000; curve "linear"; }; fade-out { off; }; }' \
        >"$XDG_RUNTIME_DIR/wedge.kdl"
    "$BIN" -c "$XDG_RUNTIME_DIR/wedge.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "fade: wedge config never locked"; kill "$pid"; return; }
    $T wtype -s 300 "$PASSWORD" -k Return
    wait_exit "$pid"
    check "fade: password during the fade-in exits" "$?" 0

    # A second unlock request during the fade-out unlocks at once, so a long fade-out can always
    # be cut short (the second request was once ignored).
    printf '%s\n' 'background { color "#ffffff"; }' \
        'animations { fade-in { off; }; fade-out { duration-ms 3000; curve "linear"; }; }' \
        >"$XDG_RUNTIME_DIR/long.kdl"
    "$BIN" -c "$XDG_RUNTIME_DIR/long.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "fade: long fade-out never locked"; kill "$pid"; return; }
    kill -USR1 "$pid"
    sleep 0.3
    t0=$(date +%s%N)
    kill -USR1 "$pid"
    wait_exit "$pid"
    t1=$(date +%s%N)
    ms=$(( (t1 - t0) / 1000000 ))
    [ "$ms" -lt 1500 ] && pass "fade: a second request cuts the fade-out short (${ms} ms)" \
        || fail "fade: the second request waited for the fade-out (${ms} ms)"
}

t_grace() {
    printf '%s\n' 'animations { off; }' >"$XDG_RUNTIME_DIR/off.kdl"
    start_desktop
    "$BIN" --grace 3 -c "$XDG_RUNTIME_DIR/off.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "grace: never locked"; kill "$pid"; return; }
    $T wtype -s 300 x
    wait_exit "$pid"
    check "grace: a key within the grace period unlocks" "$?" 0
    check_unlocked "grace"
    kill "$DESKTOP_PID"
    # With a fade-out, a second key in the grace period does not cut it short.
    printf '%s\n' 'animations { fade-in { off; }; fade-out { duration-ms 3000; curve "linear"; }; }' \
        >"$XDG_RUNTIME_DIR/fade.kdl"
    "$BIN" --grace 5 -c "$XDG_RUNTIME_DIR/fade.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "grace: fade run never locked"; kill "$pid"; return; }
    $T wtype -s 300 x
    $T wtype -s 300 x
    sleep 0.2
    alive "$pid" && pass "grace: a second key keeps the fade-out running" \
        || fail "grace: a second key cut the fade-out short"
    wait_exit "$pid"
    check "grace: the fade-out ends in the unlock" "$?" 0
    "$BIN" --grace 1 -c "$XDG_RUNTIME_DIR/off.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "grace: second never locked"; kill "$pid"; return; }
    sleep 1.5
    $T wtype -s 300 x
    sleep 0.5
    kill -0 "$pid" 2>/dev/null && pass "grace: after the grace period a key does not unlock" \
        || fail "grace: unlocked after the grace period"
    kill -USR1 "$pid"
    wait_exit "$pid"

    # A suspend inside the grace period uses it up (the boot clock counts the sleep), so the key
    # that wakes the machine does not unlock it.
    local shim
    shim=$(build_clock_jump) || { fail "grace: cannot build the clock shim"; return; }
    LD_PRELOAD="$shim" CLOCK_JUMP_TRIGGER="$XDG_RUNTIME_DIR/jump" \
        "$BIN" --grace 30 -c "$XDG_RUNTIME_DIR/off.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "grace: suspend run never locked"; kill "$pid"; return; }
    touch "$XDG_RUNTIME_DIR/jump"
    $T wtype -s 300 x
    sleep 0.5
    kill -0 "$pid" 2>/dev/null && pass "grace: a suspend inside the grace period ends it" \
        || fail "grace: the wake key unlocked after a simulated 1 h suspend"
    kill -USR1 "$pid"
    wait_exit "$pid"

    # An unreadable boot clock means no grace at all: it used to read as 0 forever, so the
    # window never closed and any later key unlocked.
    LD_PRELOAD="$shim" CLOCK_BOOTTIME_FAIL=1 \
        "$BIN" --grace 1 -c "$XDG_RUNTIME_DIR/off.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "grace: failing-clock run never locked"; kill "$pid"; return; }
    sleep 1.5
    $T wtype -s 300 x
    sleep 0.5
    kill -0 "$pid" 2>/dev/null && pass "grace: a failing boot clock closes the grace period" \
        || fail "grace: a key unlocked after the grace period with a failing boot clock"
    kill -USR1 "$pid"
    wait_exit "$pid"

    # A value that overflows the clock is refused before locking (it used to abort after).
    $T "$BIN" --grace 18446744073709551615 -c "$XDG_RUNTIME_DIR/off.kdl" >"$LOG" 2>&1
    check "grace: an overflowing value exits 1" "$?" 1
    grep -q 'session locked' "$LOG" && fail "grace: locked with an overflowing value" \
        || pass "grace: an overflowing value is refused before locking"
}

# Pixels of the output (cursor included, grim -c) that are not "r g b", within BOX (x0 y0 x1 y1).
# Usage: cursor_pixels "R G B" X0 Y0 X1 Y1
cursor_pixels() {
    $T grim -c -t ppm - | python3 -c '
import sys
want = tuple(int(v) for v in sys.argv[1].split())
x0, y0, x1, y1 = map(int, sys.argv[2:6])
data = sys.stdin.buffer.read()
parts = data.split(None, 4)
w, h = int(parts[1]), int(parts[2])
px = data[len(data) - w * h * 3:]
print(sum(1 for y in range(y0, y1) for x in range(x0, x1)
          if tuple(px[(y * w + x) * 3:(y * w + x) * 3 + 3]) != want))' "$@"
}

t_pointer() {
    # A virtual pointer (contrib/vptr): the headless seat has none of its own.
    printf '%s\n' 'background { color "#204060"; }' 'animations { off; }' >"$XDG_RUNTIME_DIR/lock.kdl"
    local pid n
    # Within the grace period pointer motion unlocks, and so does a click. A pointer created
    # after locking gets only `enter` for its first move (that is not input; a real cursor is
    # already over the lock surface), so each case moves once first.
    start_desktop
    for how in "move 5 5" "click"; do
        "$BIN" --grace 30 -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
        pid=$!
        wait_locked "$LOG" || { fail "pointer: grace never locked"; cat "$LOG"; kill "$pid"; return; }
        # shellcheck disable=SC2086
        $T "$HERE/vptr" move 5 5 sleep 300 $how >/dev/null
        wait_exit "$pid"
        check "pointer: $how within the grace period unlocks" "$?" 0
        check_unlocked "pointer $how"
    done
    kill "$DESKTOP_PID"
    # After it, the pointer does nothing.
    "$BIN" --grace 1 -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "pointer: late never locked"; kill "$pid"; return; }
    sleep 1.5
    $T "$HERE/vptr" move 5 5 click >/dev/null
    sleep 0.5
    kill -0 "$pid" 2>/dev/null && pass "pointer: after the grace period the pointer does not unlock" \
        || fail "pointer: unlocked after the grace period"

    # hide-cursor (the default): no cursor over the lock screen. The pointer starts at the
    # output's centre; it is moved a little so sway draws it.
    $T "$HERE/vptr" move 10 10 sleep 500 >/dev/null &
    local vp=$!
    sleep 0.3
    n=$(cursor_pixels "32 64 96" 0 0 320 240)
    check "pointer: hide-cursor, no cursor drawn" "$n" 0
    wait "$vp"
    kill -USR1 "$pid"
    wait_exit "$pid"
    # hide-cursor false: the compositor draws its cursor.
    printf '%s\n' 'background { color "#204060"; }' 'animations { off; }' 'general { hide-cursor false; }' \
        >"$XDG_RUNTIME_DIR/cursor.kdl"
    "$BIN" -c "$XDG_RUNTIME_DIR/cursor.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "pointer: cursor never locked"; kill "$pid"; return; }
    $T "$HERE/vptr" move 10 10 sleep 500 >/dev/null &
    vp=$!
    sleep 0.3
    n=$(cursor_pixels "32 64 96" 0 0 320 240)
    [ "$n" -gt 20 ] && pass "pointer: hide-cursor false, the cursor is drawn ($n px)" \
        || fail "pointer: hide-cursor false, no cursor drawn ($n px)"
    wait "$vp"
    kill -USR1 "$pid"
    wait_exit "$pid"
}

t_fingerprint() {
    # A private bus stands in for the system bus, with a fake fprintd on it.
    local busdir="$XDG_RUNTIME_DIR/bus"
    mkdir -p "$busdir"
    dbus-daemon --session --nofork --address="unix:path=$busdir/sock" --print-address >/dev/null 2>&1 &
    local busd=$!
    for _ in $(seq 30); do [ -S "$busdir/sock" ] && break; sleep 0.1; done
    export DBUS_SYSTEM_BUS_ADDRESS="unix:path=$busdir/sock"

    start_desktop
    "$HERE/fake-fprintd" verify-finger-not-centered verify-no-match verify-match >"$XDG_RUNTIME_DIR/fprintd.log" 2>&1 &
    local fake=$!
    for _ in $(seq 30); do grep -q ready "$XDG_RUNTIME_DIR/fprintd.log" 2>/dev/null && break; sleep 0.1; done

    cat >"$XDG_RUNTIME_DIR/lock.kdl" <<'EOF'
background { color "#000000"; }
auth { fingerprint { retry-delay-ms 100; }; }
label { text "$FPRINTPROMPT"; font "Sans 12"; color "#ffffff"; }
animations { off; }
EOF
    "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "fingerprint: never locked"; cat "$LOG"; kill "$pid" "$fake" "$busd"; return; }
    wait_exit "$pid"
    check "fingerprint: a match unlocks" "$?" 0
    check_unlocked "fingerprint"
    kill "$DESKTOP_PID"
    local log
    log=$(tr '\n' ' ' <"$XDG_RUNTIME_DIR/fprintd.log")
    case "$log" in
        *"VerifyStart any"*"status verify-no-match"*"VerifyStart any"*"status verify-match"*)
            pass "fingerprint: retried after a non-match" ;;
        *) fail "fingerprint: unexpected fprintd log: $log" ;;
    esac
    case "$log" in
        *Release*) pass "fingerprint: device released on exit" ;;
        *) fail "fingerprint: device not released: $log" ;;
    esac
    # fprintd's protocol: Claim before VerifyStart (the fake, like fprintd, refuses otherwise),
    # and VerifyStop before Release.
    case "$log" in
        *REFUSED*) fail "fingerprint: fprintd refused a call: $log" ;;
        *Claim*"VerifyStart any"*) pass "fingerprint: Claim before VerifyStart" ;;
        *) fail "fingerprint: protocol order: $log" ;;
    esac
    case "${log##*status verify-match}" in
        " "[0-9]*" VerifyStop "[0-9]*" Release ") pass "fingerprint: VerifyStop, then Release after the match" ;;
        *) fail "fingerprint: after the match: ${log##*status verify-match}" ;;
    esac
    kill "$fake" 2>/dev/null

    # A prompt change is drawn by itself (nothing else redraws here): a finger on the reader
    # replaces the short ready message with the long present message.
    printf '%s\n' 'background { color "#000000"; }' 'animations { off; }' \
        'auth { fingerprint { ready-message "r"; present-message "present-present-present"; }; }' \
        'label { text "$FPRINTPROMPT"; font "Sans 16"; color "#ffffff"; }' >"$XDG_RUNTIME_DIR/present.kdl"
    "$HERE/fake-fprintd" pause finger-present >"$XDG_RUNTIME_DIR/fprintd.log" 2>&1 &
    fake=$!
    for _ in $(seq 30); do grep -q ready "$XDG_RUNTIME_DIR/fprintd.log" 2>/dev/null && break; sleep 0.1; done
    "$BIN" -c "$XDG_RUNTIME_DIR/present.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "fingerprint: present run never locked"; kill "$pid" "$fake" "$busd"; return; }
    local w_ready w_present
    for _ in $(seq 30); do grep -q VerifyStart "$XDG_RUNTIME_DIR/fprintd.log" && break; sleep 0.1; done
    sleep 0.5
    w_ready=$(colour_width "255 255 255" 0 0 320 240)
    for _ in $(seq 40); do grep -q finger-present "$XDG_RUNTIME_DIR/fprintd.log" && break; sleep 0.1; done
    sleep 0.5
    w_present=$(colour_width "255 255 255" 0 0 320 240)
    [ "$w_present" -gt $((w_ready + 50)) ] \
        && pass "fingerprint: the present prompt is drawn when a finger touches ($w_ready -> $w_present px)" \
        || fail "fingerprint: prompt not redrawn on finger-present ($w_ready -> $w_present px)"
    kill -USR1 "$pid"
    wait_exit "$pid"
    kill "$fake" 2>/dev/null; wait "$fake" 2>/dev/null

    # The prompts reach the screen: $FPRINTPROMPT is the ready message, then the present message
    # when a finger touches, then the retry status's own text. retry-delay-ms is honoured: the
    # restart after a non-match comes no sooner.
    cat >"$XDG_RUNTIME_DIR/prompt.kdl" <<EOF
auth { fingerprint { ready-message "ready-msg"; present-message "present-msg"; retry-delay-ms 1200; }; }
animations { off; }
label { text "cmd[update:100] echo \"\$FPRINTPROMPT\" >> $XDG_RUNTIME_DIR/prompts"; }
EOF
    "$HERE/fake-fprintd" finger-present verify-finger-not-centered verify-no-match verify-match \
        >"$XDG_RUNTIME_DIR/fprintd.log" 2>&1 &
    fake=$!
    for _ in $(seq 30); do grep -q ready "$XDG_RUNTIME_DIR/fprintd.log" 2>/dev/null && break; sleep 0.1; done
    "$BIN" -c "$XDG_RUNTIME_DIR/prompt.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "fingerprint: prompt run never locked"; kill "$pid" "$fake" "$busd"; return; }
    wait_exit "$pid"
    check "fingerprint: prompt run unlocks on the match" "$?" 0
    local seen
    seen=$(uniq "$XDG_RUNTIME_DIR/prompts" 2>/dev/null | tr '\n' '|')
    case "$seen" in
        *ready-msg*present-msg*"Finger not centered"*"Could not match"*)
            pass "fingerprint: ready, present and retry prompts shown in order" ;;
        *) fail "fingerprint: prompts shown: $seen" ;;
    esac
    # The gap between the non-match and the next VerifyStart is the retry delay.
    local nomatch restart
    nomatch=$(awk '/status verify-no-match/ {print $1; exit}' "$XDG_RUNTIME_DIR/fprintd.log")
    restart=$(awk -v t="${nomatch:-0}" '$2 == "VerifyStart" && $1 > t {print $1; exit}' "$XDG_RUNTIME_DIR/fprintd.log")
    { [ -n "$restart" ] && [ $((restart - nomatch)) -ge 1100 ]; } \
        && pass "fingerprint: retry-delay-ms honoured ($((restart - nomatch)) ms)" \
        || fail "fingerprint: restart $((${restart:-0} - ${nomatch:-0})) ms after the non-match (want >= 1200)"
    kill "$fake" 2>/dev/null; wait "$fake" 2>/dev/null

    # Forged signals from a process that does not own net.reactivated.Fprint must be ignored,
    # broadcast or addressed to the locker directly. The fake never reports a status here.
    "$HERE/fake-fprintd" >"$XDG_RUNTIME_DIR/fprintd.log" 2>&1 &
    fake=$!
    for _ in $(seq 30); do grep -q ready "$XDG_RUNTIME_DIR/fprintd.log" 2>/dev/null && break; sleep 0.1; done
    "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "fingerprint: forgery run never locked"; kill "$pid" "$fake" "$busd"; return; }
    for _ in $(seq 30); do grep -q VerifyStart "$XDG_RUNTIME_DIR/fprintd.log" && break; sleep 0.1; done
    # The forger must actually run, or this check proves nothing.
    "$HERE/forge-fprint" broadcast >/dev/null && "$HERE/forge-fprint" directed >/dev/null \
        || fail "fingerprint: forge-fprint did not run"
    sleep 1.5
    kill -0 "$pid" 2>/dev/null && pass "fingerprint: forged VerifyStatus does not unlock" \
        || fail "fingerprint: a forged VerifyStatus unlocked the session"
    # A forged PrepareForSleep must not stop scanning either.
    "$HERE/forge-fprint" directed sleep >/dev/null || fail "fingerprint: forge-fprint did not run"
    sleep 0.5
    if grep -q VerifyStop "$XDG_RUNTIME_DIR/fprintd.log"; then
        fail "fingerprint: a forged PrepareForSleep stopped scanning"
    else
        pass "fingerprint: forged PrepareForSleep ignored"
    fi
    kill -USR1 "$pid" 2>/dev/null
    wait_exit "$pid"
    kill "$fake" 2>/dev/null; wait "$fake" 2>/dev/null

    # Sleep during the retry delay: the retry must not restart the scan while asleep; waking
    # restarts it.
    "$HERE/fake-fprintd" verify-no-match+sleep >"$XDG_RUNTIME_DIR/fprintd.log" 2>&1 &
    fake=$!
    for _ in $(seq 30); do grep -q ready "$XDG_RUNTIME_DIR/fprintd.log" 2>/dev/null && break; sleep 0.1; done
    printf '%s\n' 'auth { fingerprint { retry-delay-ms 1000; }; }' 'animations { off; }' >"$XDG_RUNTIME_DIR/sleep.kdl"
    "$BIN" -c "$XDG_RUNTIME_DIR/sleep.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "fingerprint: sleep run never locked"; kill "$pid" "$fake" "$busd"; return; }
    for _ in $(seq 60); do grep -q WAKE "$XDG_RUNTIME_DIR/fprintd.log" && break; sleep 0.1; done
    sleep 0.5
    log=$(tr '\n' ' ' <"$XDG_RUNTIME_DIR/fprintd.log")
    case "$log" in
        *SLEEP*VerifyStart*WAKE*) fail "fingerprint: scanning restarted while asleep: $log" ;;
        *SLEEP*WAKE*VerifyStart*) pass "fingerprint: no scan while asleep, rescans on wake" ;;
        *) fail "fingerprint: unexpected sleep log: $log" ;;
    esac
    case "$log" in
        *WAKE*VerifyStart*VerifyStart*) fail "fingerprint: scan started twice after wake: $log" ;;
    esac
    kill -USR1 "$pid"
    wait_exit "$pid"
    kill "$fake" 2>/dev/null; wait "$fake" 2>/dev/null

    # Sleep and wake inside the retry delay: waking restarts the scan, and the retry must not
    # start it a second time (fprintd refuses that with AlreadyInUse). The match then unlocks.
    "$HERE/fake-fprintd" verify-no-match+quicksleep verify-match >"$XDG_RUNTIME_DIR/fprintd.log" 2>&1 &
    fake=$!
    for _ in $(seq 30); do grep -q ready "$XDG_RUNTIME_DIR/fprintd.log" 2>/dev/null && break; sleep 0.1; done
    "$BIN" -c "$XDG_RUNTIME_DIR/sleep.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "fingerprint: quick sleep run never locked"; kill "$pid" "$fake" "$busd"; return; }
    wait_exit "$pid"
    check "fingerprint: sleep inside the retry delay, then a match unlocks" "$?" 0
    log=$(tr '\n' ' ' <"$XDG_RUNTIME_DIR/fprintd.log")
    case "$log" in
        *REFUSED*) fail "fingerprint: VerifyStart twice after a quick wake: $log" ;;
        *) pass "fingerprint: one VerifyStart after a quick wake" ;;
    esac
    kill -0 "$pid" 2>/dev/null && { kill -USR1 "$pid"; wait_exit "$pid"; }
    kill "$fake" 2>/dev/null; wait "$fake" 2>/dev/null

    # fprintd going away mid-lock: the prompt clears and $FPRINTFAIL says why.
    cat >"$XDG_RUNTIME_DIR/vanish.kdl" <<EOF
auth { fingerprint { ready-message "scan"; }; }
animations { off; }
label { text "cmd[update:200] echo \"\$FPRINTPROMPT|\$FPRINTFAIL\" > $XDG_RUNTIME_DIR/fpvars"; }
EOF
    "$HERE/fake-fprintd" >"$XDG_RUNTIME_DIR/fprintd.log" 2>&1 &
    fake=$!
    for _ in $(seq 30); do grep -q ready "$XDG_RUNTIME_DIR/fprintd.log" 2>/dev/null && break; sleep 0.1; done
    RUST_LOG=swaywardlock=debug "$BIN" -c "$XDG_RUNTIME_DIR/vanish.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "fingerprint: vanish run never locked"; kill "$pid" "$fake" "$busd"; return; }
    for _ in $(seq 30); do grep -qx 'scan|' "$XDG_RUNTIME_DIR/fpvars" 2>/dev/null && break; sleep 0.1; done
    check "fingerprint: ready prompt before fprintd goes" "$(cat "$XDG_RUNTIME_DIR/fpvars" 2>/dev/null)" "scan|"
    kill "$fake"; wait "$fake" 2>/dev/null
    for _ in $(seq 30); do grep -qx '|Fingerprint unavailable' "$XDG_RUNTIME_DIR/fpvars" && break; sleep 0.1; done
    check "fingerprint: fprintd gone clears the prompt and sets \$FPRINTFAIL" \
        "$(cat "$XDG_RUNTIME_DIR/fpvars" 2>/dev/null)" "|Fingerprint unavailable"
    grep -q 'fprintd went away' "$LOG" && pass "fingerprint: fprintd gone is logged" \
        || fail "fingerprint: no warning when fprintd went away"
    $T wtype -s 300 "$PASSWORD" -k Return
    wait_exit "$pid"
    check "fingerprint: password unlocks after fprintd went away" "$?" 0

    # Four non-matches give up (three restarts, as hyprlock); the lock stays and PAM still works.
    printf '%s\n' 'auth { fingerprint { retry-delay-ms 100; }; }' 'animations { off; }' \
        "label { text \"cmd[update:200] echo \$ATTEMPTS > $XDG_RUNTIME_DIR/attempts\"; }" \
        >"$XDG_RUNTIME_DIR/lock.kdl"
    "$HERE/fake-fprintd" verify-no-match verify-no-match verify-no-match verify-no-match verify-match >"$XDG_RUNTIME_DIR/fprintd.log" 2>&1 &
    fake=$!
    for _ in $(seq 30); do grep -q ready "$XDG_RUNTIME_DIR/fprintd.log" 2>/dev/null && break; sleep 0.1; done
    "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "fingerprint: second never locked"; kill "$pid" "$fake" "$busd"; return; }
    sleep 3.5
    kill -0 "$pid" 2>/dev/null && pass "fingerprint: gives up after four non-matches" \
        || fail "fingerprint: unlocked after four non-matches"
    # Each miss is a failed attempt, as in hyprlock: the cmd[] label sees $ATTEMPTS = 4.
    grep -qx 4 "$XDG_RUNTIME_DIR/attempts" && pass "fingerprint: misses count as failed attempts" \
        || fail "fingerprint: \$ATTEMPTS after four misses is '$(cat "$XDG_RUNTIME_DIR/attempts" 2>/dev/null)'"
    $T wtype -s 300 "$PASSWORD" -k Return
    wait_exit "$pid"
    check "fingerprint: password still unlocks" "$?" 0

    # No fprintd on the bus: the locker runs normally.
    kill "$fake" 2>/dev/null; wait "$fake" 2>/dev/null
    "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" && pass "fingerprint: locks without fprintd" || fail "fingerprint: no lock without fprintd"
    kill -USR1 "$pid"
    wait_exit "$pid"
    unset DBUS_SYSTEM_BUS_ADDRESS
    kill "$busd"
}

t_otp() {
    # The test build's second user takes a password and then a one-time code, like a PAM stack
    # with pam_oath after pam_unix: the code is asked in the same transaction, after Enter.
    printf '%s\n' 'background { color "#204060"; }' 'ring-indicator { idle-visible; }' \
        'label { text "[$PAMPROMPT]"; font "Sans 20"; color "#ffff00"; valign "top"; position 0 -10; }' \
        'animations { off; }' >"$XDG_RUNTIME_DIR/lock.kdl"
    start_desktop
    RUST_LOG=swaywardlock=debug "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "otp: never locked"; cat "$LOG"; kill "$pid" "$DESKTOP_PID"; return; }
    local prompt_pw prompt_otp
    # The baseline is taken once the first frame is up, or "Password" can read as 0 px.
    prompt_pw=$(settled_width "255 255 0" 0 0 320 60)
    # One keyboard throughout (wtype's goes away after each run, and that redraws anyway).
    vkbd_start 7 vk-otp
    local vk=$VK_PID
    echo "type swaywardlock-2fa" >&7
    echo "key Return" >&7
    sleep 0.8
    grep -q 'PAM prompt: OTP: ' "$LOG" && pass "otp: the second question reaches the UI" \
        || fail "otp: no OTP prompt after the password"
    # $PAMPROMPT is redrawn with the question: "[OTP: ]" is narrower than "[Password: ]".
    prompt_otp=$(colour_width "255 255 0" 0 0 320 60)
    { [ "$prompt_otp" -gt 0 ] && [ "$prompt_otp" -lt "$prompt_pw" ]; } \
        && pass "otp: \$PAMPROMPT redrawn with the code question ($prompt_pw -> $prompt_otp px)" \
        || fail "otp: \$PAMPROMPT not redrawn ($prompt_pw -> $prompt_otp px)"
    kill -0 "$pid" 2>/dev/null && pass "otp: the password alone does not unlock" \
        || fail "otp: exited after the password alone"
    # Not a failure: one sample (the wrong-password colour would still show within the fail
    # timeout) finds the ring idle, ready for the code.
    check "otp: waiting for the code, not failed" "$(pixel "${RING[@]}")" "51 125 0"
    # A wrong code fails the attempt; the next transaction asks for the password again.
    $T wtype -s 300 000000 -k Return
    sleep 0.8
    kill -0 "$pid" 2>/dev/null && pass "otp: a wrong code keeps the lock" \
        || fail "otp: exited on a wrong code"
    grep -q 'authentication failed' "$LOG" && pass "otp: a wrong code is a failed attempt" \
        || fail "otp: a wrong code was not reported as a failure"
    sleep 3
    $T wtype -s 300 swaywardlock-2fa -k Return
    sleep 0.8
    $T wtype -s 300 123456 -k Return
    wait_exit "$pid"
    check "otp: password then code unlocks" "$?" 0
    echo quit >&7
    exec 7>&-
    wait "$vk" 2>/dev/null
    check_unlocked "otp"
    kill "$DESKTOP_PID"
}

t_pam_service() {
    # A missing PAM service file would fall back to /etc/pam.d/other (deny): every password
    # refused, only SIGUSR1 could end the lock. Refuse to lock instead, naming the file.
    # (Test builds look in SWAYWARDLOCK_TEST_PAM_DIR instead of /etc/pam.d.)
    local dir="$XDG_RUNTIME_DIR/pam.d"
    mkdir -p "$dir"
    printf '%s\n' 'auth { pam service="swl-missing"; }' >"$XDG_RUNTIME_DIR/lock.kdl"
    SWAYWARDLOCK_TEST_PAM_DIR="$dir" $T "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1
    check "pam service: missing file exits 1" "$?" 1
    grep -q 'session locked' "$LOG" && fail "pam service: locked without a PAM service file" \
        || pass "pam service: never locked without a PAM service file"
    grep -q "$dir/swl-missing" "$LOG" && pass "pam service: the error names the file" \
        || { fail "pam service: the error does not name the file"; cat "$LOG"; }
    # With the file present it locks; pam off needs no file.
    : >"$dir/swl-missing"
    SWAYWARDLOCK_TEST_PAM_DIR="$dir" "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" && pass "pam service: locks when the file exists" \
        || { fail "pam service: did not lock with the file present"; cat "$LOG"; }
    kill -USR1 "$pid"
    wait_exit "$pid"
    printf '%s\n' 'auth { pam { off; }; }' >"$XDG_RUNTIME_DIR/off.kdl"
    SWAYWARDLOCK_TEST_PAM_DIR="$dir" "$BIN" -c "$XDG_RUNTIME_DIR/off.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" && pass "pam service: pam { off; } locks without a file" \
        || { fail "pam service: pam { off; } did not lock"; cat "$LOG"; }
    kill -USR1 "$pid"
    wait_exit "$pid"
}

t_pam_off() {
    # pam { off; }: only SIGUSR1 unlocks. Enter, empty or after typing, is a failed attempt and
    # never an unlock, whatever is typed (the test password too).
    printf '%s\n' 'background { color "#204060"; }' 'ring-indicator { idle-visible; }' \
        'animations { off; }' 'auth { pam { off; }; }' >"$XDG_RUNTIME_DIR/lock.kdl"
    start_desktop
    RUST_LOG=swaywardlock=debug "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "pam off: never locked"; cat "$LOG"; kill "$pid" "$DESKTOP_PID"; return; }
    grep -q 'PAM is disabled' "$LOG" && pass "pam off: the log says PAM is disabled" \
        || fail "pam off: no warning that PAM is disabled"
    $T wtype -s 300 -k Return
    sleep 0.5
    $T wtype -s 300 "$PASSWORD" -k Return
    sleep 0.5
    kill -0 "$pid" 2>/dev/null && pass "pam off: Enter and the test password keep the lock" \
        || fail "pam off: Enter unlocked with PAM off"
    check_colour "pam off: Enter is a failed attempt" "125 51 0" "${RING[@]}"
    check "pam off: the desktop stays covered" "$(pixel 5 5)" "32 64 96"
    kill -USR1 "$pid"
    wait_exit "$pid"
    check "pam off: SIGUSR1 unlocks" "$?" 0
    check_unlocked "pam off"
    kill "$DESKTOP_PID"
}

# Two outputs: a background scoped to one output stays there, and with two unscoped backgrounds
# the last one wins (spec).
t_outputs() {
    printf '%s\n' 'animations { off; }' 'background { color "#ff0000"; }' \
        'background { color "#0000ff"; }' 'background output="HEADLESS-2" { color "#00ff00"; }' \
        >"$XDG_RUNTIME_DIR/lock.kdl"
    swaymsg_ create_output >/dev/null
    swaymsg_ output HEADLESS-2 resolution 320x240 position 320 0 >/dev/null
    "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "outputs: never locked"; cat "$LOG"; kill "$pid"; return; }
    local o want got
    for o in "HEADLESS-1 0 0 255" "HEADLESS-2 0 255 0"; do
        want=${o#* }
        for _ in $(seq 30); do
            got=$($T grim -o "${o%% *}" -t ppm - 2>/dev/null | python3 "$HERE/ppm-pixel" 5 5)
            [ "$got" = "$want" ] && break
            sleep 0.1
        done
        check "outputs: ${o%% *} background" "$got" "$want"
    done
    kill -USR1 "$pid"
    wait_exit "$pid"
}

t_hotplug() {
    # An output plugged in while locked gets a lock surface of its own (sway shows its red lock
    # colour on an output with none), and one unplugged takes its surface away without breaking
    # the unlock.
    printf '%s\n' 'background { color "#204060"; }' 'animations { off; }' >"$XDG_RUNTIME_DIR/lock.kdl"
    WAYLAND_DEBUG=1 "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "hotplug: never locked"; cat "$LOG"; kill "$pid"; return; }
    swaymsg_ create_output >/dev/null
    local got
    for _ in $(seq 30); do
        got=$($T grim -o HEADLESS-2 -t ppm - 2>/dev/null | python3 "$HERE/ppm-pixel" 5 5)
        [ "$got" = "32 64 96" ] && break
        sleep 0.1
    done
    check "hotplug: a new output is covered by the lock screen" "$got" "32 64 96"
    local destroyed
    destroyed=$(grep -c 'ext_session_lock_surface_v1#[0-9]*\.destroy()' "$LOG")
    swaymsg_ output HEADLESS-2 unplug >/dev/null
    sleep 0.5
    alive "$pid" && pass "hotplug: survives the output going" || fail "hotplug: died when the output went"
    # Its lock surface goes with it (a stale one would be drawn into until the unlock).
    [ "$(grep -c 'ext_session_lock_surface_v1#[0-9]*\.destroy()' "$LOG")" -gt "$destroyed" ] \
        && pass "hotplug: the unplugged output's lock surface is destroyed" \
        || fail "hotplug: the unplugged output's lock surface is kept"
    swaymsg_ create_output >/dev/null
    for _ in $(seq 30); do
        got=$($T grim -o HEADLESS-3 -t ppm - 2>/dev/null | python3 "$HERE/ppm-pixel" 5 5)
        [ "$got" = "32 64 96" ] && break
        sleep 0.1
    done
    check "hotplug: an output plugged after an unplug is covered" "$got" "32 64 96"
    swaymsg_ output HEADLESS-3 unplug >/dev/null
    sleep 0.5
    kill -USR1 "$pid"
    wait_exit "$pid"
    check "hotplug: SIGUSR1 unlocks after outputs came and went" "$?" 0
    grep -q 'Protocol error\|protocol error' "$LOG" && fail "hotplug: $(grep -m1 -i 'protocol error' "$LOG")" \
        || pass "hotplug: no protocol error"
}

t_scale_change() {
    # A 100x40 logical shape at the top left, through scale changes while locked: its physical
    # width follows the scale both ways (the buffer scale and the EGL size are updated). Integer
    # scale path, so set_buffer_scale and the EGL resize are what is tested.
    printf '%s\n' 'background { color "#204060"; }' \
        'shape { size 100 40; color "#ff0000"; halign "left"; valign "top"; corner-radius 0; }' \
        'animations { off; }' >"$XDG_RUNTIME_DIR/lock.kdl"
    SWAYWARDLOCK_TEST_NO_FRACTIONAL=1 "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "scale change: never locked"; cat "$LOG"; kill "$pid"; return; }
    local s w
    for s in 1 2 1; do
        swaymsg_ output HEADLESS-1 scale "$s" >/dev/null
        for _ in $(seq 30); do
            w=$(colour_width "255 0 0" 0 5 320 10)
            [ "$w" = $((100 * s)) ] && break
            sleep 0.1
        done
        check "scale change: shape is $((100 * s)) px wide at scale $s" "$w" $((100 * s))
    done
    kill -USR1 "$pid"
    wait_exit "$pid"
}

# Start contrib/vkbd in the background with commands on a fifo; sets VK_PID and opens fd $1.
# Usage: vkbd_start FD LOGNAME [vkbd options...]
vkbd_start() {
    local fd=$1 name=$2
    shift 2
    mkfifo "$XDG_RUNTIME_DIR/$name.in"
    "$HERE/vkbd" "$@" stdin <"$XDG_RUNTIME_DIR/$name.in" >"$XDG_RUNTIME_DIR/$name.log" 2>&1 &
    VK_PID=$!
    eval "exec $fd>\"\$XDG_RUNTIME_DIR/\$name.in\""
    for _ in $(seq 30); do grep -q ready "$XDG_RUNTIME_DIR/$name.log" 2>/dev/null && break; sleep 0.1; done
    grep -q ready "$XDG_RUNTIME_DIR/$name.log" || { fail "vkbd $name did not start"; cat "$XDG_RUNTIME_DIR/$name.log"; }
}

t_keyboard() {
    printf '%s\n' 'background { color "#000000"; }' 'animations { off; }' \
        'label { text "$LAYOUT"; font "Sans 20"; color "#ff0000"; }' >"$XDG_RUNTIME_DIR/lock.kdl"
    local pid vk

    # A keyboard with layouts us,de (group 0 active) is attached before the locker starts. The
    # first frame is drawn before the keymap arrives and no modifiers event follows, so $LAYOUT
    # must still show up without any key press.
    vkbd_start 7 vk-layout --layout us,de
    vk=$VK_PID
    RUST_LOG=swaywardlock=debug "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "keyboard: never locked"; cat "$LOG"; kill "$pid" "$vk"; return; }
    local width=0
    for _ in $(seq 10); do
        width=$(colour_width "255 0 0" 0 0 320 240)
        [ "$width" -gt 0 ] && break
        sleep 0.1
    done
    [ "$width" -gt 0 ] && pass "keyboard: \$LAYOUT drawn without a key press ($width px)" \
        || fail "keyboard: \$LAYOUT empty until a key is pressed"

    # Holding BackSpace deletes the junk by key repeat (sway: 25/s after 600 ms), then the
    # password unlocks. A held letter does not repeat (as in hyprlock): one t, not many.
    echo "type aaaaaaaaaa" >&7
    echo "hold BackSpace 2000" >&7
    echo "type ${PASSWORD%t}" >&7
    echo "hold t 1500" >&7
    echo "key Return" >&7
    wait_exit "$pid"
    check "keyboard: held BackSpace clears, held letter types once, password unlocks" "$?" 0
    echo quit >&7
    exec 7>&-
    wait "$vk" 2>/dev/null

    # Two seats. The locker binds the keyboard of every seat, and a keyboard leaving one seat does
    # not release another seat's keyboard (swaylock binds them all too).
    swaymsg_ seat seat1 fallback false >/dev/null
    vkbd_start 7 vk-seat0 --seat seat0
    local vk0=$VK_PID
    RUST_LOG=swaywardlock=debug "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "keyboard: seats never locked"; cat "$LOG"; kill "$pid" "$vk0"; return; }
    # A keyboard comes and goes on seat1 while seat0's stays.
    $T "$HERE/vkbd" --seat seat1 "sleep 500" >/dev/null 2>&1
    sleep 0.5
    echo "type $PASSWORD" >&7
    echo "key Return" >&7
    wait_exit "$pid"
    check "keyboard: seat0 still types after a seat1 keyboard came and went" "$?" 0

    # seat0's keyboard goes away; a keyboard on seat1 (added while locked) still unlocks.
    RUST_LOG=swaywardlock=debug "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "keyboard: seats 2 never locked"; cat "$LOG"; kill "$pid" "$vk0"; return; }
    vkbd_start 8 vk-seat1 --seat seat1
    local vk1=$VK_PID
    echo quit >&7
    exec 7>&-
    wait "$vk0" 2>/dev/null
    sleep 0.5
    echo "type $PASSWORD" >&8
    echo "key Return" >&8
    wait_exit "$pid"
    check "keyboard: seat1 keyboard unlocks after seat0's keyboard is gone" "$?" 0
    echo quit >&8
    exec 8>&-
    wait "$vk1" 2>/dev/null
}

# Ctrl shortcuts and Caps Lock from a keyboard's modifiers. wtype never sends a modifiers event,
# so vkbd sends the masks the way a real keyboard's compositor does (4 = Ctrl, 2 = Caps Lock).
t_modifiers() {
    printf '%s\n' 'background { color "#000000"; }' 'animations { off; }' \
        'input-field { size 200 50; inner-color "#ffffff"; outline { width 4; color "#0000ff"; }; capslock-color "#ff00ff"; fade-on-empty false; }' \
        >"$XDG_RUNTIME_DIR/lock.kdl"
    vkbd_start 7 vk-mods
    local vk=$VK_PID
    "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "modifiers: never locked"; cat "$LOG"; kill "$pid" "$vk"; return; }
    check_colour "modifiers: outline without Caps Lock" "0 0 255" 160 92
    printf '%s\n' "key Caps_Lock" "mods 0 0 2" >&7
    check_colour "modifiers: Caps Lock gives the field its capslock colour" "255 0 255" 160 92
    printf '%s\n' "key Caps_Lock" "mods 0 0 0" >&7
    check_colour "modifiers: Caps Lock off restores the outline" "0 0 255" 160 92
    # Junk cleared with Ctrl+U, more junk with Ctrl+BackSpace, then the password submitted with
    # Ctrl+J. Without Ctrl the u and j are typed and BackSpace deletes one character only.
    ctrl() { printf '%s\n' "down Control_L" "mods 4 0 0" "key $1" "up Control_L" "mods 0 0 0" >&7; }
    echo "type abcdef" >&7
    ctrl u
    echo "type xyz" >&7
    ctrl BackSpace
    echo "type $PASSWORD" >&7
    ctrl j
    wait_exit "$pid"
    check "modifiers: Ctrl+U and Ctrl+BackSpace clear, Ctrl+J submits" "$?" 0
    echo quit >&7
    exec 7>&-
    wait "$vk" 2>/dev/null
}

# $LAYOUT and Caps/Num state belong to the keyboard that spoke last among those still present.
t_keyboard_layout() {
    printf '%s\n' 'background { color "#000000"; }' 'animations { off; }' \
        'label { text "$LAYOUT"; font "Sans 20"; color "#ff0000"; }' >"$XDG_RUNTIME_DIR/lock.kdl"
    swaymsg_ seat seat1 fallback false >/dev/null
    vkbd_start 7 vk-de --seat seat0 --layout de,us
    local vk0=$VK_PID
    RUST_LOG=swaywardlock=debug "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "keyboard layout: never locked"; cat "$LOG"; kill "$pid" "$vk0"; return; }
    local de=0 us=0 now
    echo "key Shift_L" >&7
    for _ in $(seq 10); do
        de=$(colour_width "255 0 0" 0 0 320 240)
        [ "$de" -gt 0 ] && break
        sleep 0.1
    done
    # A second seat's keyboard with another layout comes: its keymap alone does not take over
    # from the keyboard that typed; its key makes it the one shown.
    vkbd_start 8 vk-us --seat seat1 --layout us
    local vk1=$VK_PID
    sleep 0.5
    check "keyboard layout: a keyboard that only arrived is not shown" \
        "$(colour_width "255 0 0" 0 0 320 240)" "$de"
    echo "key Shift_L" >&8
    sleep 0.5
    us=$(colour_width "255 0 0" 0 0 320 240)
    [ "$us" -gt 0 ] && [ "$us" != "$de" ] \
        && pass "keyboard layout: the keyboard that spoke last is shown ($de px, then $us px)" \
        || fail "keyboard layout: seat1's layout not shown ($de px, then $us px)"
    echo "key Shift_L" >&7
    sleep 0.5
    now=$(colour_width "255 0 0" 0 0 320 240)
    check "keyboard layout: back to seat0's layout after a key there" "$now" "$de"
    # A modifiers change (Caps Lock from another device of that seat) speaks too.
    echo "mods 0 0 2" >&8
    sleep 0.5
    check "keyboard layout: a modifiers change makes its keyboard the one shown" \
        "$(colour_width "255 0 0" 0 0 320 240)" "$us"
    echo "mods 0 0 0" >&8
    echo "key Shift_L" >&7
    sleep 0.5
    # seat1 speaks again and goes: the remaining keyboard's layout returns.
    echo "key Shift_L" >&8
    sleep 0.5
    echo quit >&8
    exec 8>&-
    wait "$vk1" 2>/dev/null
    sleep 0.5
    now=$(colour_width "255 0 0" 0 0 320 240)
    check "keyboard layout: the remaining keyboard's layout returns when the other goes" "$now" "$de"
    kill -USR1 "$pid"
    wait_exit "$pid"
    echo quit >&7
    exec 7>&-
    wait "$vk0" 2>/dev/null
}

# Main-thread wakeups of PID over SECONDS seconds (voluntary context switches).
wakeups() {
    local a b
    a=$(awk '/^voluntary/ {print $2}' "/proc/$1/status")
    sleep "$2"
    b=$(awk '/^voluntary/ {print $2}' "/proc/$1/status")
    echo $((b - a))
}

# A key held while its keyboard goes away, with the compositor's key release and leave hidden
# (the protocol does not require them before a capability change): nothing keeps repeating.
t_keyboard_repeat() {
    printf '%s\n' 'background { color "#000000"; }' 'animations { off; }' \
        'input-field { size 200 50; inner-color "#ffffff"; font-color "#000000"; outline { width 4; color "#0000ff"; }; dots size=0.4 spacing=0.5; fade-on-empty false; }' \
        >"$XDG_RUNTIME_DIR/lock.kdl"
    swaymsg_ seat seat1 fallback false >/dev/null
    local real=$WAYLAND_DISPLAY
    "$HERE/wl-drop-key-release" &
    local proxy=$!
    for _ in $(seq 30); do [ -e "$XDG_RUNTIME_DIR/droprel-ready" ] && break; sleep 0.1; done
    vkbd_start 7 vk-seat0 --seat seat0
    local vk0=$VK_PID
    WAYLAND_DISPLAY=wayland-droprel-0 RUST_LOG=swaywardlock=debug "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" \
        >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "keyboard repeat: never locked"; cat "$LOG"; kill "$pid" "$vk0" "$proxy"; return; }
    echo "type abcdefghijkl" >&7
    # A burst of wakeups lands about 1.75 s after the typing on both the old and the new build
    # (not repeat); measure after it. A leaked repeat timer would show about 50 in the window.
    sleep 2.5
    local base
    base=$(wakeups "$pid" 2)
    [ "$base" -lt 10 ] && pass "keyboard repeat: idle locker ($base wakeups in 2 s)" \
        || fail "keyboard repeat: idle locker wakes $base times in 2 s"
    # seat1 holds BackSpace and its keyboard goes away; the repeat deleted a few dots first.
    WAYLAND_DISPLAY=$real $T "$HERE/vkbd" --seat seat1 "hold BackSpace 1500" >/dev/null 2>&1
    sleep 0.5
    local w1 w2
    w1=$(colour_width "0 0 0" 62 112 258 128)
    local woke
    woke=$(wakeups "$pid" 2)
    w2=$(colour_width "0 0 0" 62 112 258 128)
    check "keyboard repeat: the dots stop changing once the keyboard is gone" "$w2" "$w1"
    [ "$woke" -lt 10 ] && pass "keyboard repeat: no repeat timer left running ($woke wakeups in 2 s)" \
        || fail "keyboard repeat: $woke wakeups in 2 s after the keyboard went (a repeat timer survives)"
    grep -q 'seat capability removed' "$LOG" || fail "keyboard repeat: no capability removal seen"
    echo "key Escape" >&7
    echo "type $PASSWORD" >&7
    echo "key Return" >&7
    wait_exit "$pid"
    check "keyboard repeat: seat0 still unlocks" "$?" 0
    echo quit >&7
    exec 7>&-
    wait "$vk0" 2>/dev/null
    kill "$proxy" 2>/dev/null
    wait "$proxy" 2>/dev/null
}

t_validate() {
    echo 'ring-indicator { radius 0; }' >"$XDG_RUNTIME_DIR/bad.kdl"
    $T "$BIN" validate -c "$XDG_RUNTIME_DIR/bad.kdl" >"$LOG" 2>&1
    check "validate: bad config exit code" "$?" 1
    grep -q 'radius\|between' "$LOG" && pass "validate: error explains the value" \
        || { fail "validate: error does not explain the value"; cat "$LOG"; }
    echo 'ring-indicator { radius 20; }' >"$XDG_RUNTIME_DIR/good.kdl"
    $T "$BIN" validate -c "$XDG_RUNTIME_DIR/good.kdl" >"$LOG" 2>&1
    check "validate: good config exit code" "$?" 0
    # off is written as a child node everywhere (animations { off }); pam takes it too.
    echo 'auth { pam { off; }; }' >"$XDG_RUNTIME_DIR/pamoff.kdl"
    $T "$BIN" validate -c "$XDG_RUNTIME_DIR/pamoff.kdl" >"$LOG" 2>&1
    check "validate: pam { off; } is accepted" "$?" 0
    # A bad config must stop the locker before it locks.
    $T "$BIN" -c "$XDG_RUNTIME_DIR/bad.kdl" >"$LOG" 2>&1
    check "validate: locker refuses a bad config" "$?" 1
    grep -q 'session locked' "$LOG" && fail "validate: locked despite a bad config" \
        || pass "validate: never locked with a bad config"
    # Every kdl example in the spec, and the shipped example, must validate.
    local spec="$HERE/../docs/specs/2026-10-19-swaywardlock.md" n=0 bad=0 f
    while IFS= read -r f; do
        n=$((n + 1))
        "$BIN" validate -c "$f" >"$LOG" 2>&1 || { bad=$((bad + 1)); cat "$LOG"; }
    done < <(python3 - "$spec" "$XDG_RUNTIME_DIR" <<'PY'
import re, sys
s = open(sys.argv[1]).read()
for i, block in enumerate(re.findall(r"```kdl\n(.*?)```", s, re.S)):
    path = f"{sys.argv[2]}/spec{i}.kdl"
    open(path, "w").write(block)
    print(path)
PY
    )
    for f in "$HERE"/../examples/*.kdl; do
        "$BIN" validate -c "$f" >"$LOG" 2>&1 || { bad=$((bad + 1)); cat "$LOG"; }
    done
    { [ "$n" -ge 7 ] && [ "$bad" = 0 ]; } && pass "validate: the spec's $n examples and the example configs" \
        || fail "validate: $bad of $n spec examples (+ example configs) failed"
    # glow belongs to the swayward style: with swaylock's it is refused.
    echo 'ring-indicator { glow 4; }' >"$XDG_RUNTIME_DIR/glow.kdl"
    $T "$BIN" validate -c "$XDG_RUNTIME_DIR/glow.kdl" >"$LOG" 2>&1
    check "validate: glow with the swaylock style is refused" "$?" 1
}

t_fractional() {
    # A 100 px wide shape at the top-left. At scale 1.5 it must end exactly at physical x 150:
    # downsampling a scale-2 buffer blends the edge (66 54 81 at x 150 before fractional scale).
    # Only x edges are checked: a partial row at the bottom edge shows up at 1.5 either way.
    printf '%s\n' 'background { color "#204060"; }' \
        'shape { size 100 50; color "#ff0000"; halign "left"; valign "top"; corner-radius 0; }' \
        'animations { off; }' >"$XDG_RUNTIME_DIR/lock.kdl"
    swaymsg_ output HEADLESS-1 scale 1.5 >/dev/null
    RUST_LOG=swaywardlock=debug "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "fractional: never locked"; cat "$LOG"; kill "$pid"; return; }
    check_colour "fractional: shape fill" "255 0 0" 149 10
    check_colour "fractional: shape right edge is crisp" "32 64 96" 150 10
    grep -q 'fractional scale: on' "$LOG" && pass "fractional: used wp_fractional_scale" \
        || fail "fractional: never used wp_fractional_scale"
    kill -USR1 "$pid"
    wait_exit "$pid"

    # The scale changing while locked.
    swaymsg_ output HEADLESS-1 scale 1 >/dev/null
    "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "fractional: runtime never locked"; cat "$LOG"; kill "$pid"; return; }
    check_colour "fractional: at scale 1 the edge is at 100" "32 64 96" 100 10
    swaymsg_ output HEADLESS-1 scale 1.5 >/dev/null
    check_colour "fractional: scale change, shape fill" "255 0 0" 149 10
    check_colour "fractional: scale change, right edge is crisp" "32 64 96" 150 10
    kill -USR1 "$pid"
    wait_exit "$pid"

    # Without the globals (test hook), the integer scale path: scale 2, edge at 200.
    swaymsg_ output HEADLESS-1 scale 2 >/dev/null
    SWAYWARDLOCK_TEST_NO_FRACTIONAL=1 WAYLAND_DEBUG=1 RUST_LOG=swaywardlock=debug \
        "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "fractional: fallback never locked"; cat "$LOG"; kill "$pid"; return; }
    check_colour "fractional: integer fallback, shape fill" "255 0 0" 199 10
    check_colour "fractional: integer fallback, right edge" "32 64 96" 200 10
    grep -q 'fractional scale: unavailable, using integer scale 2' "$LOG" \
        && pass "fractional: integer fallback ran" || fail "fractional: integer fallback did not run"
    grep -q 'set_buffer_scale(2)' "$LOG" && pass "fractional: fallback sets buffer scale 2" \
        || fail "fractional: fallback never sent set_buffer_scale(2)"
    grep -q 'get_viewport\|get_fractional_scale' "$LOG" \
        && fail "fractional: fallback still created viewport/fractional objects" \
        || pass "fractional: fallback creates no viewport/fractional objects"
    kill -USR1 "$pid"
    wait_exit "$pid"
    swaymsg_ output HEADLESS-1 scale 1 >/dev/null
}

t_dark_output() {
    # An output powered off while locked (swayidle's DPMS off) sends no frame callbacks. With
    # Mesa's default swap interval 1 the next redraw (here a cmd[update:300] tick) blocked in
    # eglSwapBuffers until the output woke, ignoring the password and SIGUSR1.
    printf '%s\n' 'animations { off; }' 'label { text "cmd[update:300] date +%N"; }' \
        >"$XDG_RUNTIME_DIR/lock.kdl"
    "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "dark output: never locked"; cat "$LOG"; kill "$pid"; return; }
    swaymsg_ output HEADLESS-1 power off >/dev/null
    sleep 1.5
    $T wtype -s 300 "$PASSWORD" -k Return
    wait_exit "$pid"
    check "dark output: the password unlocks with the output off" "$?" 0

    # A second output powered off; the first stays on.
    swaymsg_ output HEADLESS-1 power on >/dev/null
    swaymsg_ create_output >/dev/null
    "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "dark output: two outputs never locked"; kill "$pid"; return; }
    sleep 0.5
    swaymsg_ output HEADLESS-2 power off >/dev/null
    sleep 1.5
    kill -USR1 "$pid"
    wait_exit "$pid"
    check "dark output: SIGUSR1 unlocks with a second output off" "$?" 0
}

t_no_wayland_egl() {
    # libwayland-egl is loaded lazily on the first EGL window surface, which once came after
    # lock(): a broken library panicked with the session locked. It must fail before locking.
    command -v cc >/dev/null || { fail "no wayland-egl: needs a C compiler"; return; }
    local lib="$XDG_RUNTIME_DIR/fake-egl"
    mkdir -p "$lib"
    cc -shared -o "$lib/libwayland-egl.so.1" -x c /dev/null
    LD_LIBRARY_PATH="$lib" $T "$BIN" >"$LOG" 2>&1
    check "no wayland-egl: exit code" "$?" 1
    grep -q 'session locked' "$LOG" && fail "no wayland-egl: locked before failing" \
        || pass "no wayland-egl: failed before locking"
}

t_cmd_output() {
    # A label command printing 200k lines once kept the main thread in Pango for minutes.
    cmd_output_case "cmd output" 'cmd[] seq 200000' usr1
    # CR-separated lines (progress output) got past a newline-only line count: 32k of them fit in
    # 64 KiB. Changing every 500 ms, they kept the password from being read for minutes.
    cmd_output_case "cmd output, CR lines" \
        "cmd[update:500] date +%N; yes a | head -32000 | tr '\\\\n' '\\\\r'" password
    # One line of 16000 TABs: Pango's layout cost grows faster than linearly with the tab stops
    # in a paragraph (about 0.5 s per layout here), inside both caps above.
    cmd_output_case "cmd output, TABs" \
        "cmd[update:500] date +%N; yes a | head -16000 | tr '\\\\n' '\\\\t'" password
}

# Lock with one label running CMD, then time an unlock by usr1 or password. SIGUSR1 must land
# within 1 s; the password within 2 s (wtype waits 300 ms and types 18 keys).
# Usage: cmd_output_case NAME CMD usr1|password
cmd_output_case() {
    printf '%s\n' 'animations { off; }' "label { text \"$2\"; font \"Sans 6\"; }" \
        >"$XDG_RUNTIME_DIR/lock.kdl"
    "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "$1: never locked"; cat "$LOG"; kill "$pid"; return; }
    sleep 1 # the output has arrived and is being drawn
    local t0 t1
    t0=$(date +%s%N)
    if [ "$3" = usr1 ]; then kill -USR1 "$pid"; else $T wtype -s 300 "$PASSWORD" -k Return; fi
    wait_exit "$pid"
    local rc=$?
    t1=$(date +%s%N)
    check "$1: exit code" "$rc" 0
    local ms=$(( (t1 - t0) / 1000000 )) limit=1000
    [ "$3" = usr1 ] || limit=2000
    [ "$ms" -lt "$limit" ] && pass "$1: $3 honoured at once (${ms} ms)" \
        || fail "$1: $3 took ${ms} ms"
}

t_label_redraws() {
    # 20 labels re-running every 200 ms with output that never changes: each result used to cost
    # a full draw of every surface (about 200 draws in 2 s). Unchanged text draws nothing, and the
    # first results arrive together, so a handful of draws is all there is.
    printf '%s\n' 'animations { off; }' >"$XDG_RUNTIME_DIR/lock.kdl"
    for i in $(seq 20); do
        echo "label { text \"cmd[update:200] echo $i\"; position 0 $((i * 5)); }" \
            >>"$XDG_RUNTIME_DIR/lock.kdl"
    done
    RUST_LOG=swaywardlock=trace "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "label redraws: never locked"; cat "$LOG"; kill "$pid"; return; }
    sleep 0.5 # the first results are in
    local before after
    before=$(grep -c 'draw_all' "$LOG")
    sleep 2
    after=$(grep -c 'draw_all' "$LOG")
    [ $((after - before)) -le 5 ] && pass "label redraws: constant output not redrawn ($((after - before)) draws in 2 s)" \
        || fail "label redraws: $((after - before)) draws in 2 s for constant output"
    kill -USR1 "$pid"
    wait_exit "$pid"
}

t_unplug() {
    # Three of four outputs unplugged back to back while locked: with swap interval 1 the main
    # thread blocked in eglSwapBuffers (ppoll) and neither the password nor SIGUSR1 unlocked.
    printf '%s\n' 'animations { off; }' 'background { color "#204060"; }' \
        'label { text "cmd[update:300] date +%N"; }' >"$XDG_RUNTIME_DIR/lock.kdl"
    local how n pid sc first=2
    for how in password usr1; do
        for n in 1 2 3; do swaymsg_ create_output >/dev/null; done
        for n in $(seq "$first" $((first + 2))); do
            swaymsg_ output "HEADLESS-$n" resolution 160x120 position $((n * 400)) 0 >/dev/null
        done
        "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
        pid=$!
        wait_locked "$LOG" || { fail "unplug $how: never locked"; cat "$LOG"; kill "$pid"; return; }
        sleep 1
        for n in $(seq $((first + 2)) -1 "$first"); do
            swaymsg_ output "HEADLESS-$n" unplug >/dev/null
        done
        sleep 1.5
        # 271 is ppoll, where eglSwapBuffers waits for a frame callback; idle is epoll_wait.
        sc=$(cut -d' ' -f1 "/proc/$pid/syscall" 2>/dev/null)
        [ "$sc" != 271 ] && pass "unplug $how: main thread not stuck in ppoll (syscall $sc)" \
            || fail "unplug $how: main thread stuck in ppoll"
        if [ "$how" = usr1 ]; then kill -USR1 "$pid"; else $T wtype -s 300 "$PASSWORD" -k Return; fi
        wait_exit "$pid"
        check "unplug $how: unlocks after three of four outputs are unplugged" "$?" 0
        first=$((first + 3))
    done
}

t_sigterm() {
    # SIGTERM keeps its default action (the session stays locked), but the cmd[] children, in
    # their own process groups, used to be left running.
    local d="$XDG_RUNTIME_DIR"
    printf '%s\n' 'animations { off; }' "label { text \"cmd[] echo \$\$ > $d/child; exec sleep 300\"; }" \
        "label { text \"cmd[] sleep 302 >/dev/null & echo \$! > $d/bg; echo started\"; }" >"$d/lock.kdl"
    "$BIN" -c "$d/lock.kdl" >"$LOG" 2>&1 &
    local pid=$! child bg
    wait_locked "$LOG" || { fail "sigterm: never locked"; cat "$LOG"; kill "$pid"; return; }
    for _ in $(seq 30); do [ -s "$d/child" ] && [ -s "$d/bg" ] && break; sleep 0.1; done
    child=$(cat "$d/child")
    bg=$(cat "$d/bg")
    sleep 0.3 # the background job's shell has exited
    alive "$child" && pass "sigterm: label command running" || fail "sigterm: command not started"
    kill -TERM "$pid"
    wait_exit "$pid"
    check "sigterm: default action (killed by SIGTERM)" "$?" 143
    sleep 0.3
    if alive "$child"; then
        fail "sigterm: cmd[] child left running"
        kill "$child"
    else
        pass "sigterm: cmd[] children killed"
    fi
    if alive "$bg"; then
        fail "sigterm: background job of a cmd[] label left running"
        kill "$bg"
    else
        pass "sigterm: background job of a cmd[] label killed"
    fi

    # Under nohup (SIGHUP ignored) the terminal closing must not kill the locker: that would
    # leave the session locked with nothing to unlock it. An ignored signal stays ignored.
    ( trap '' HUP; exec "$BIN" -c "$d/lock.kdl" ) >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "sigterm: nohup run never locked"; cat "$LOG"; kill "$pid"; return; }
    kill -HUP "$pid"
    sleep 0.5
    alive "$pid" && pass "sigterm: SIGHUP ignored under nohup stays ignored" \
        || fail "sigterm: killed by SIGHUP although it was ignored (nohup)"
    kill -USR1 "$pid"
    wait_exit "$pid"
    check "sigterm: SIGUSR1 unlocks after the ignored SIGHUP" "$?" 0

    # Ctrl+C on --preview. Background jobs start with SIGINT ignored; give it the default back.
    rm -f "$d/child"
    env --default-signal=INT "$BIN" --preview -c "$d/lock.kdl" >"$LOG" 2>&1 &
    pid=$!
    for _ in $(seq 50); do [ -s "$d/child" ] && break; sleep 0.1; done
    child=$(cat "$d/child")
    kill -INT "$pid"
    wait_exit "$pid"
    check "sigterm: preview killed by SIGINT" "$?" 130
    sleep 0.3
    if alive "$child"; then
        fail "sigterm: preview's cmd[] child left running after SIGINT"
        kill "$child"
    else
        pass "sigterm: preview's cmd[] children killed on SIGINT"
    fi
}

t_widgets() {
    local d="$XDG_RUNTIME_DIR"
    cat >"$d/lock.kdl" <<'EOF'
background { color "#204060"; }
animations { off; }
// hyprlock's shape: size is the fill, the border goes around it.
shape {
    size 100 60; color "#ff0000"; corner-radius 0
    halign "left"; valign "top"; position 20 -20
    border { width 4; color "#00ff00"; }
}
// border width 0 means no border (hyprlock's border_size 0 default).
shape {
    size 40 40; color "#ff0000"; corner-radius 0
    halign "right"; valign "top"; position -10 -10
    border { width 0; color "#00ff00"; }
}
// An image's border radius is its corner-radius plus the border width (hyprlock): 60 px
// picture, radius 20, 6 px border, so the outer corner has radius 26.
image { path "FACE"; size 60; corner-radius 20; border { width 6; color "#00ffff"; }; halign "left"; valign "bottom"; position 10 10; }
// Text that starts with cmd[ but has no ] is plain text, as in hyprlock.
label { text "cmd[ HELLO"; font "Sans Bold 30"; color "#ffffff"; valign "bottom"; position 0 10; }
EOF
    python3 "$HERE/ppm-pixel" --write-test-png "$d/face.png"
    sed -i "s|FACE|$d/face.png|" "$d/lock.kdl"
    "$BIN" -c "$d/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "widgets: never locked"; cat "$LOG"; kill "$pid"; return; }
    check_colour "widgets: shape border is outside the size" "0 255 0" 124 50
    # The image's outer box is x 10..82, y 158..230. Two rows below its top edge a radius-26
    # corner starts at x 25 (radius 20: x 20).
    check_colour "widgets: image border corner has radius + width" "32 64 96" 22 160
    check_colour "widgets: image border just inside the corner" "0 255 255" 30 160
    check "widgets: shape fill spans exactly its size" "$(colour_width "255 0 0" 0 45 200 55)" 100
    check_colour "widgets: border width 0 keeps the fill" "255 0 0" 290 30
    [ "$(colour_width "255 255 255" 0 150 320 240)" -gt 0 ] && pass "widgets: unclosed cmd[ label is drawn as text" \
        || fail "widgets: unclosed cmd[ label is not drawn"
    kill -USR1 "$pid"
    wait_exit "$pid"

    # A widget texture over the GPU limit (16384 px on llvmpipe; at scale 2 the image is over it)
    # is skipped; the background still draws.
    swaymsg_ output HEADLESS-1 scale 2 >/dev/null
    printf '%s\n' 'background { color "#204060"; }' 'animations { off; }' \
        "image { path \"$d/face.png\"; size 10000; }" >"$d/huge.kdl"
    "$BIN" -c "$d/huge.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "widgets: huge never locked"; cat "$LOG"; kill "$pid"; return; }
    check_colour "widgets: an oversized image leaves the background" "32 64 96" 5 5
    grep -q 'GPU texture limit' "$LOG" && pass "widgets: oversized textures are logged" \
        || fail "widgets: oversized textures not logged"
    kill -USR1 "$pid"
    wait_exit "$pid"
    # A ring is capped at 4096 px instead (it is redrawn per key): radius 9000 at scale 2 renders
    # at a lower scale and its inside fill (default #000000c0 over #204060) covers the output.
    printf '%s\n' 'background { color "#204060"; }' 'animations { off; }' \
        'ring-indicator { radius 9000; idle-visible; }' >"$d/huge.kdl"
    "$BIN" -c "$d/huge.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "widgets: huge ring never locked"; cat "$LOG"; kill "$pid"; return; }
    check_colour "widgets: a huge ring draws, capped" "8 16 24" 5 5
    grep -q 'GPU texture limit' "$LOG" && fail "widgets: the capped ring hit the texture limit" \
        || pass "widgets: the capped ring stays under the texture limit"
    kill -USR1 "$pid"
    wait_exit "$pid"
    # The swayward style (redrawn every animation frame) is capped too, glow included.
    printf '%s\n' 'background { color "#204060"; }' 'animations { off; }' \
        'ring-indicator { style "swayward"; glow 64; radius 9000; idle-visible; }' >"$d/huge.kdl"
    "$BIN" -c "$d/huge.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "widgets: huge swayward ring never locked"; cat "$LOG"; kill "$pid"; return; }
    check_colour "widgets: a huge swayward ring draws, capped" "8 16 24" 5 5
    grep -q 'GPU texture limit' "$LOG" && fail "widgets: the capped swayward ring hit the texture limit" \
        || pass "widgets: the capped swayward ring stays under the texture limit"
    kill -USR1 "$pid"
    wait_exit "$pid"
    swaymsg_ output HEADLESS-1 scale 1 >/dev/null

    # blur { passes 0 } is no blur (hyprlock): the red/blue seam of the test image stays sharp.
    printf '%s\n' "background { path \"$d/face.png\"; fit \"fill\"; blur { passes 0; offset 50; }; }" \
        'animations { off; }' >"$d/blur.kdl"
    "$BIN" -c "$d/blur.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "widgets: blur never locked"; cat "$LOG"; kill "$pid"; return; }
    check_colour "widgets: blur passes 0, red above the seam" "255 0 0" 160 100
    check_colour "widgets: blur passes 0, blue below the seam" "0 0 255" 160 140
    kill -USR1 "$pid"
    wait_exit "$pid"

    # Blur and brightness change the pixels. The test image is red above, blue below; blurred,
    # the seam's rows mix, and red bleeds into the blue half. brightness 0.5 halves the red.
    printf '%s\n' "background { path \"$d/face.png\"; fit \"fill\"; blur { passes 3; offset 8; }; }" \
        'animations { off; }' >"$d/blur.kdl"
    "$BIN" -c "$d/blur.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "widgets: blur on never locked"; cat "$LOG"; kill "$pid"; return; }
    sleep 0.3
    local seam
    seam=$(pixel 160 122)
    { [ "$(echo "$seam" | cut -d' ' -f1)" -gt 40 ] && [ "$(echo "$seam" | cut -d' ' -f3)" -gt 40 ]; } \
        && pass "widgets: blur mixes red and blue at the seam ($seam)" \
        || fail "widgets: no blur at the seam ($seam)"
    # Far from the seam the half keeps its colour (the blur spreads, it does not tint).
    local far
    far=$(pixel 160 30)
    { [ "$(echo "$far" | cut -d' ' -f1)" -gt 200 ] && [ "$(echo "$far" | cut -d' ' -f3)" -lt 60 ]; } \
        && pass "widgets: blur keeps red far from the seam ($far)" \
        || fail "widgets: blur changed the colour far from the seam ($far)"
    kill -USR1 "$pid"
    wait_exit "$pid"
    printf '%s\n' "background { path \"$d/face.png\"; fit \"fill\"; brightness 0.5; }" \
        'animations { off; }' >"$d/dim.kdl"
    "$BIN" -c "$d/dim.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "widgets: brightness never locked"; cat "$LOG"; kill "$pid"; return; }
    check_colour "widgets: brightness 0.5 halves the colour" "128 0 0" 160 30
    kill -USR1 "$pid"
    wait_exit "$pid"

    # The spec's label example must put the label on screen (it once sat above the top edge).
    local spec="$HERE/../docs/specs/2026-10-19-swaywardlock.md"
    python3 - "$spec" >"$d/label.kdl" <<'PYEOF'
import re, sys
s = open(sys.argv[1]).read()
block = next(b for b in re.findall(r"```kdl\n(.*?)```", s, re.S) if b.startswith("label {"))
print('background { color "#000000"; }\nanimations { off; }\n' + block.replace('"$TIME"', '"HELLO"'))
PYEOF
    "$BIN" -c "$d/label.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "widgets: spec label never locked"; cat "$LOG"; kill "$pid"; return; }
    sleep 0.3
    [ "$(settled_width "255 255 255" 0 0 320 240)" -gt 0 ] && pass "widgets: the spec's label example is on screen" \
        || fail "widgets: the spec's label example is off screen"
    kill -USR1 "$pid"
    wait_exit "$pid"

    # A relative image path resolves against the config file's directory, not the cwd.
    mkdir -p "$d/conf"
    python3 "$HERE/ppm-pixel" --write-test-png "$d/conf/rel.png"
    printf '%s\n' 'background { color "#00ff00"; path "rel.png"; fit "fill"; }' 'animations { off; }' \
        >"$d/conf/rel.kdl"
    local bin
    bin=$(realpath "$BIN")
    (cd / && exec "$bin" -c "$d/conf/rel.kdl") >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "widgets: relative never locked"; cat "$LOG"; kill "$pid"; return; }
    check_colour "widgets: relative image path loads from the config dir" "255 0 0" 160 10
    kill -USR1 "$pid"
    wait_exit "$pid"

    # The same with a relative -c path and -f: the daemon chdirs to /, so the config's directory
    # must have been made absolute first. The cmd[] child's parent is the daemon.
    printf '%s\n' 'background { color "#00ff00"; path "rel.png"; fit "fill"; }' 'animations { off; }' \
        "label { text \"cmd[] echo \$PPID >$d/conf/pid; echo x\"; }" >"$d/conf/rel.kdl"
    local cfg from daemon
    for cfg in rel.kdl ./rel.kdl conf/rel.kdl; do
        from=$d/conf
        [ "$cfg" = conf/rel.kdl ] && from=$d
        rm -f "$d/conf/pid"
        (cd "$from" && exec $T "$bin" -f -c "$cfg") >"$LOG" 2>&1
        check "widgets: -f -c $cfg, parent exit code" "$?" 0
        for _ in $(seq 50); do [ -s "$d/conf/pid" ] && break; sleep 0.1; done
        daemon=$(cat "$d/conf/pid" 2>/dev/null)
        [ -n "$daemon" ] || { fail "widgets: -f -c $cfg, no daemon pid"; cat "$LOG"; continue; }
        check_colour "widgets: -f -c $cfg, relative image path loads" "255 0 0" 160 10
        kill -USR1 "$daemon"
        for _ in $(seq 50); do alive "$daemon" || break; sleep 0.1; done
        alive "$daemon" && { fail "widgets: -f -c $cfg, daemon did not exit"; kill "$daemon"; }
    done
}

t_tiny_output() {
    # A 16x16 output: shapes and the input field shrink below a pixel; never abort.
    swaymsg_ output HEADLESS-1 resolution 16x16 >/dev/null
    "$BIN" -c "$HERE/../examples/hyprlock-example.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "tiny output: never locked"; cat "$LOG"; kill "$pid"; return; }
    sleep 1
    alive "$pid" && pass "tiny output: still running" || { fail "tiny output: died"; tail -5 "$LOG"; }
    kill -USR1 "$pid" 2>/dev/null
    wait_exit "$pid"
    check "tiny output: unlocks" "$?" 0
}

t_huge_output() {
    # Wider than the GPU texture limit (16384 px on llvmpipe): the background is drawn at the
    # limit and stretched, with a warning, instead of missing (black).
    swaymsg_ output HEADLESS-1 resolution 20000x100 >/dev/null
    printf '%s\n' 'background { color "#204060"; }' 'animations { off; }' >"$XDG_RUNTIME_DIR/lock.kdl"
    "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "huge output: never locked"; cat "$LOG"; kill "$pid"; return; }
    check_colour "huge output: background colour" "32 64 96" 5 5
    grep -q 'over the GPU texture limit' "$LOG" && pass "huge output: warned" \
        || fail "huge output: no warning"
    kill -USR1 "$pid"
    wait_exit "$pid"
    check "huge output: unlocks" "$?" 0
}

t_hidpi_first_frame() {
    # wl_output.scale is known before the lock surface exists: the first commit uses it.
    swaymsg_ output HEADLESS-1 scale 2 >/dev/null
    printf '%s\n' 'background { color "#204060"; }' 'animations { off; }' >"$XDG_RUNTIME_DIR/lock.kdl"
    SWAYWARDLOCK_TEST_NO_FRACTIONAL=1 WAYLAND_DEBUG=1 "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "hidpi: never locked"; cat "$LOG"; kill "$pid"; return; }
    sleep 0.5
    check "hidpi: first commit uses the output scale" \
        "$(grep -o -m1 'set_buffer_scale([0-9]*)' "$LOG")" "set_buffer_scale(2)"
    kill -USR1 "$pid"
    wait_exit "$pid"
    swaymsg_ output HEADLESS-1 scale 1 >/dev/null
}

t_sigusr1() {
    start_desktop
    RUST_LOG=swaywardlock=debug "$BIN" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || fail "sigusr1: never locked"
    check_colour "sigusr1: the lock covers the desktop" "163 163 163" 5 5
    kill -USR1 "$pid"
    wait_exit "$pid"
    check "sigusr1: exit code" "$?" 0
    check_unlocked "sigusr1"
    kill "$DESKTOP_PID"

    # More signals right behind the unlock must not change the exit code (dropping the event
    # loop used to unblock them, and their default action killed the process: 138/140).
    local i
    for i in 1 2 3; do
        "$BIN" >"$LOG" 2>&1 &
        pid=$!
        wait_locked "$LOG" || { fail "sigusr1: storm run $i never locked"; kill "$pid"; return; }
        # Keep signalling until the process is gone, so some arrive during the teardown.
        ( while kill -USR1 "$pid" && kill -USR2 "$pid"; do :; done ) 2>/dev/null &
        local storm=$!
        wait_exit "$pid"
        check "sigusr1: exit code with signals during teardown (run $i)" "$?" 0
        wait "$storm" 2>/dev/null
    done
}

t_early_unlock() {
    # An unlock that arrives before `locked` must happen once `locked` does, not be dropped, and
    # must not be sent early (unlock before locked leaves the compositor locked). A proxy holds
    # `locked` back while SIGUSR1 arrives, so the real deferral in request_unlock runs.
    start_desktop
    local plog="$XDG_RUNTIME_DIR/hold.log" trigger="$XDG_RUNTIME_DIR/release-locked"
    "$HERE/wl-inject-finished" --hold-locked "$trigger" "$plog" &
    local proxy=$!
    for _ in $(seq 30); do grep -q ready "$plog" 2>/dev/null && break; sleep 0.1; done
    printf '%s\n' 'animations { off; }' >"$XDG_RUNTIME_DIR/lock.kdl"
    WAYLAND_DISPLAY=wayland-inject-0 "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    for _ in $(seq 50); do grep -q 'held locked' "$plog" 2>/dev/null && break; sleep 0.1; done
    grep -q 'held locked' "$plog" || fail "early unlock: the proxy never saw locked"
    kill -USR1 "$pid"
    for _ in $(seq 30); do grep -q deferring "$LOG" && break; sleep 0.1; done
    grep -q deferring "$LOG" && pass "early unlock: SIGUSR1 before locked is deferred" \
        || fail "early unlock: SIGUSR1 before locked was not deferred"
    sleep 0.3
    kill -0 "$pid" 2>/dev/null && pass "early unlock: still running until locked" \
        || fail "early unlock: exited before locked"
    touch "$trigger"
    wait_exit "$pid"
    check "early unlock: exit code" "$?" 0
    grep -q 'session locked' "$LOG" && pass "early unlock: locked first" \
        || fail "early unlock: exited without locking"
    grep -qx 'request unlock_and_destroy' "$plog" \
        && pass "early unlock: answered locked with unlock_and_destroy" \
        || fail "early unlock: requests: $(grep request "$plog" | tr '\n' ' ')"
    check_unlocked "early unlock"
    kill "$proxy" "$DESKTOP_PID" 2>/dev/null
    wait "$proxy" 2>/dev/null
}

t_ready_fd() {
    local ready="$XDG_RUNTIME_DIR/ready"
    "$BIN" --ready-fd 9 9>"$ready" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || fail "ready-fd: never locked"
    check "ready-fd: newline written" "$(od -An -c "$ready" | tr -d ' ')" '\n'
    kill -USR1 "$pid"
    wait_exit "$pid"

    # cmd[] children must not inherit the ready fd: one could signal "locked" early.
    local fds="$XDG_RUNTIME_DIR/child-fds"
    printf '%s\n' "label { text \"cmd[] ls /proc/\$\$/fd > $fds; echo x\"; }" 'animations { off; }' \
        >"$XDG_RUNTIME_DIR/fd.kdl"
    "$BIN" -c "$XDG_RUNTIME_DIR/fd.kdl" --ready-fd 9 9>"$ready" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || fail "ready-fd: cmd run never locked"
    for _ in $(seq 30); do [ -s "$fds" ] && break; sleep 0.1; done
    [ -s "$fds" ] || fail "ready-fd: the cmd[] child never ran"
    grep -qx 9 "$fds" && fail "ready-fd: a cmd[] child inherited fd 9" \
        || pass "ready-fd: not inherited by cmd[] children"
    kill -USR1 "$pid"
    wait_exit "$pid"

    # A number that is not open is refused before locking: by `locked` it names one of the
    # locker's own descriptors, and writing and closing that broke the locked session.
    $T "$BIN" --ready-fd 4 4>&- >"$LOG" 2>&1
    check "ready-fd: a closed descriptor exits 1" "$?" 1
    grep -q 'session locked' "$LOG" && fail "ready-fd: locked with a closed descriptor" \
        || pass "ready-fd: a closed descriptor is refused before locking"
}

t_fd_limit() {
    # A low soft limit is raised towards the hard one, so the lock does not run out after locking.
    bash -c 'ulimit -Sn 16; exec "$0"' "$BIN" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || fail "fd limit: soft 16 never locked"
    sleep 0.5
    kill -USR1 "$pid" 2>/dev/null
    wait_exit "$pid"
    check "fd limit: a soft limit of 16 is raised and the lock works" "$?" 0
    # A hard limit too small to run a lock is refused before locking.
    $T bash -c 'ulimit -n 16; exec "$0"' "$BIN" >"$LOG" 2>&1
    check "fd limit: a hard limit of 16 exits 1" "$?" 1
    grep -q 'session locked' "$LOG" && fail "fd limit: locked with a hard limit of 16" \
        || pass "fd limit: a hard limit of 16 is refused before locking"
}

t_compositor_death() {
    # Failing after `lock()` exits 3, never 1 ("never locked"): the session may still be locked.
    "$BIN" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "compositor death: never locked"; kill "$pid"; return; }
    kill "$SWAY_PID"
    wait "$SWAY_PID" 2>/dev/null
    wait_exit "$pid"
    check "compositor death: exit code after locking" "$?" 3
}

t_finished_after_locked() {
    # A compositor may send `finished` after `locked`; the answer must be unlock_and_destroy, as
    # the protocol says (a bare destroy after locked is a protocol error).
    local plog="$XDG_RUNTIME_DIR/inject.log"
    "$HERE/wl-inject-finished" "$plog" &
    local proxy=$!
    for _ in $(seq 30); do grep -q ready "$plog" 2>/dev/null && break; sleep 0.1; done
    WAYLAND_DISPLAY=wayland-inject-0 "$BIN" >"$LOG" 2>&1 &
    local pid=$!
    wait_exit "$pid"
    check "finished after locked: exit code" "$?" 2
    sleep 0.3
    grep -q 'injected finished' "$plog" && pass "finished after locked: finished injected" \
        || fail "finished after locked: the proxy never saw locked"
    grep -qx 'request unlock_and_destroy' "$plog" && ! grep -qx 'request destroy' "$plog" \
        && pass "finished after locked: answered with unlock_and_destroy" \
        || fail "finished after locked: requests: $(grep request "$plog" | tr '\n' ' ')"
    grep -q '^error' "$plog" && fail "finished after locked: $(grep '^error' "$plog")" \
        || pass "finished after locked: no protocol error"
    kill "$proxy" 2>/dev/null
    wait "$proxy" 2>/dev/null
}

t_protocol_error() {
    # A wl_display.error after `locked` (sway sends one before it drops a client) once left the
    # locker spinning at full CPU forever, logging the error on every pass, instead of exiting 3.
    local mode plog proxy pid t0 rc
    for mode in close keep-open; do
        plog="$XDG_RUNTIME_DIR/inject-$mode.log"
        rm -f "$XDG_RUNTIME_DIR/wayland-inject-0"
        if [ $mode = close ]; then
            "$HERE/wl-inject-finished" --error "$plog" &
        else
            "$HERE/wl-inject-finished" --error --keep-open "$plog" &
        fi
        proxy=$!
        for _ in $(seq 30); do grep -q ready "$plog" 2>/dev/null && break; sleep 0.1; done
        WAYLAND_DISPLAY=wayland-inject-0 "$BIN" >"$LOG" 2>&1 &
        pid=$!
        for _ in $(seq 50); do grep -q 'injected error' "$plog" 2>/dev/null && break; sleep 0.1; done
        grep -q 'injected error' "$plog" || fail "protocol error ($mode): never injected"
        t0=$(date +%s%N)
        for _ in $(seq 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
        if kill -0 "$pid" 2>/dev/null; then
            fail "protocol error ($mode): still running 2 s after the error ($(grep -c 'Protocol error' "$LOG") log lines)"
            kill -KILL "$pid"
            wait "$pid" 2>/dev/null
        else
            wait "$pid"
            rc=$?
            check "protocol error ($mode): exit code" "$rc" 3
            pass "protocol error ($mode): exited after $(( ($(date +%s%N) - t0) / 1000000 )) ms"
            # A spin logs the error on every pass: hundreds of thousands of lines.
            [ "$(grep -c 'Protocol error' "$LOG")" -lt 10 ] && pass "protocol error ($mode): no busy loop" \
                || fail "protocol error ($mode): $(grep -c 'Protocol error' "$LOG") error lines logged"
        fi
        kill "$proxy" 2>/dev/null
        wait "$proxy" 2>/dev/null
    done
}

t_zero_size() {
    # An output mode smaller than its scale (1x1 at scale 3) configures the lock surface 0x0. The
    # old-size EGL surface was kept, and the next draw (a cmd[] tick, a key) committed a buffer
    # against the acked 0x0 configure: sway killed the locker with a protocol error.
    printf '%s\n' 'animations { off; }' 'label { text "cmd[update:300] date +%N"; }' \
        >"$XDG_RUNTIME_DIR/lock.kdl"
    "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "zero size: never locked"; cat "$LOG"; kill "$pid"; return; }
    sleep 0.3
    swaymsg_ output HEADLESS-1 scale 3 >/dev/null
    swaymsg_ output HEADLESS-1 resolution 1x1 >/dev/null
    sleep 1.5
    $T wtype -s 50 a
    sleep 0.5
    if alive "$pid"; then
        pass "zero size: survives a 0x0 configure, cmd[] ticks and a key"
    else
        wait "$pid"
        fail "zero size: died (exit $?): $(grep -a 'rror' "$LOG" | grep -av 'EGL\|egl' | head -1)"
        return
    fi
    grep -q 'no usable size yet (0x0' "$LOG" && pass "zero size: got the 0x0 configure" \
        || fail "zero size: sway never sent a 0x0 configure"
    # The output comes back: drawn again, and the password still unlocks.
    swaymsg_ output HEADLESS-1 resolution 320x240 >/dev/null
    swaymsg_ output HEADLESS-1 scale 1 >/dev/null
    sleep 0.5
    # Clear the "a" typed above.
    $T wtype -s 300 -k BackSpace
    $T wtype -s 30 "$PASSWORD" -k Return
    wait_exit "$pid"
    check "zero size: password unlocks after the output returns" "$?" 0
}

t_daemonize() {
    # The parent must exit 0 only once the session is locked.
    $T "$BIN" -f >"$LOG" 2>&1
    check "daemonize: parent exit code" "$?" 0
    grep -q 'session locked' "$LOG" && pass "daemonize: locked before the parent exited" \
        || fail "daemonize: parent exited before the lock"
    # A bystander that looks like the daemon (same command line, newer, another runtime dir).
    local decoy
    ( export XDG_RUNTIME_DIR=/nonexistent; exec -a "$BIN -f" sleep 30 ) &
    decoy=$!
    # The daemon is the "$BIN -f" process whose environment has this run's XDG_RUNTIME_DIR.
    local child="" p
    for p in $(pgrep -f "^$BIN -f"); do
        if tr '\0' '\n' <"/proc/$p/environ" 2>/dev/null | grep -qx "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"; then
            child=$p
            break
        fi
    done
    [ -n "$child" ] && [ "$child" != "$decoy" ] && pass "daemonize: child keeps running" \
        || fail "daemonize: no child"
    if [ -n "$child" ]; then
        # Detached: its own session (a closing terminal's SIGHUP cannot reach it) and stdio on
        # /dev/null once locked.
        local sid fds
        sid=$(awk '{print $6}' "/proc/$child/stat")
        check "daemonize: the daemon leads its own session" "$sid" "$child"
        fds=$(for fd in 0 1 2; do readlink "/proc/$child/fd/$fd"; done | tr '\n' ' ')
        check "daemonize: stdio on /dev/null" "$fds" "/dev/null /dev/null /dev/null "
        kill -USR1 "$child"
        for _ in $(seq 50); do
            alive "$child" || break
            sleep 0.1
        done
        alive "$child" && { fail "daemonize: the daemon did not exit on SIGUSR1"; kill "$child"; } \
            || pass "daemonize: the daemon exits on SIGUSR1"
    fi
    kill -0 "$decoy" 2>/dev/null && pass "daemonize: the decoy was left alone" \
        || fail "daemonize: the decoy is gone"
    kill "$decoy" 2>/dev/null
    wait "$decoy" 2>/dev/null
}

t_preview_refresh() {
    # SIGUSR2 re-runs cmd[update:N:1] labels in preview too.
    local runs="$XDG_RUNTIME_DIR/runs"
    printf '%s\n' "label { text \"cmd[update:60000:1] echo run >>$runs; echo x\"; }" \
        >"$XDG_RUNTIME_DIR/lock.kdl"
    "$BIN" --preview -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    for _ in $(seq 50); do [ -s "$runs" ] && break; sleep 0.1; done
    sleep 0.3
    kill -USR2 "$pid"
    for _ in $(seq 30); do [ "$(wc -l <"$runs")" -ge 2 ] && break; sleep 0.1; done
    check "preview refresh: SIGUSR2 re-runs the label command" "$(wc -l <"$runs")" 2
    kill -0 "$pid" 2>/dev/null && pass "preview refresh: still running" \
        || fail "preview refresh: SIGUSR2 ended the preview"
    swaymsg_ '[app_id=swaywardlock-preview] kill' >/dev/null
    wait_exit "$pid"
}

t_clock_resume() {
    # After a resume $TIME shows the new time within about a second, not when the pre-suspend
    # minute would have ended in awake time.
    local shim
    shim=$(build_clock_jump) || { fail "clock resume: cannot build the clock shim"; return; }
    printf '%s\n' 'background { color "#000000"; }' 'animations { off; }' \
        'label { text "$TIME"; font "Sans 40"; color "#ffffff"; }' >"$XDG_RUNTIME_DIR/lock.kdl"
    # Not near the end of a minute: the real minute turning would redraw and hide a stale clock.
    while [ "$(date +%-S)" -ge 50 ]; do sleep 1; done
    LD_PRELOAD="$shim" CLOCK_JUMP_TRIGGER="$XDG_RUNTIME_DIR/jump" \
        "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "clock resume: never locked"; kill "$pid"; return; }
    sleep 0.5
    local before after
    before=$($T grim -t ppm - | md5sum)
    touch "$XDG_RUNTIME_DIR/jump"
    for _ in $(seq 25); do
        sleep 0.1
        after=$($T grim -t ppm - | md5sum)
        [ "$after" != "$before" ] && break
    done
    [ "$after" != "$before" ] && pass "clock resume: \$TIME redrawn after a simulated suspend" \
        || fail "clock resume: \$TIME still shows the time from before the suspend"
    kill -USR1 "$pid"
    wait_exit "$pid"
}

# Pixels at several points of one screenshot, one "r g b" per point, space-joined with "|".
# Usage: pixels X1 Y1 [X2 Y2 ...]
pixels() {
    $T grim -t ppm - | python3 -c '
import sys
data = sys.stdin.buffer.read()
parts, i = [], 0
while len(parts) < 4:
    while i < len(data) and data[i:i+1].isspace(): i += 1
    j = i
    while j < len(data) and not data[j:j+1].isspace(): j += 1
    if j == i: sys.exit("pixels: empty or truncated PPM")
    parts.append(data[i:j]); i = j
i += 1
w = int(parts[1])
pts = list(map(int, sys.argv[1:]))
out = []
for x, y in zip(pts[::2], pts[1::2]):
    o = i + (y * w + x) * 3
    out.append(" ".join(str(v) for v in data[o:o+3]))
print("|".join(out))' "$@"
}

# Horizontal centre (times 2, to stay an integer) of the pixels matching "r g b" on row Y.
# Usage: colour_centre2 "R G B" Y
colour_centre2() {
    $T grim -t ppm - | python3 -c '
import sys
want = tuple(int(v) for v in sys.argv[1].split())
y = int(sys.argv[2])
data = sys.stdin.buffer.read()
parts, i = [], 0
while len(parts) < 4:
    while i < len(data) and data[i:i+1].isspace(): i += 1
    j = i
    while j < len(data) and not data[j:j+1].isspace(): j += 1
    if j == i: sys.exit("colour_centre2: empty or truncated PPM")
    parts.append(data[i:j]); i = j
i += 1
w = int(parts[1])
xs = [x for x in range(w)
      if all(abs(a - b) < 60 for a, b in zip(data[i+(y*w+x)*3:i+(y*w+x)*3+3], want))]
print(min(xs) + max(xs) if xs else -1)' "$@"
}

# The swayward ring style (docs/specs/2026-10-20-ring-style.md). The swaylock style's own pixel
# checks (password, converted, ...) are the parity guard and stay as they are.
# Ring: radius 80, thickness 10, centred at (162, 120) (swaylock's 2 px nudge included).
# No highlight shares a colour with the wrong state's green: the shake probe must only find the
# inside fill (swaylock's default key highlight 33db00 is within the probe's tolerance).
ring_style_conf() {
    cat >"$XDG_RUNTIME_DIR/lock.kdl" <<'EOF'
background { color "#000000"; }
ring-indicator {
    style "swayward"
    idle-visible
    radius 80
    thickness 10
    colors {
        state "input" inside="#0000ffff"
        state "clear" inside="#ff0000ff"
        state "wrong" inside="#00ff00ff"
        key-highlight "#ff00ffff"
        bs-highlight "#ff00ffff"
    }
}
EOF
    printf '%s\n' "$@" >>"$XDG_RUNTIME_DIR/lock.kdl"
    # RING_BASE=1 runs the checks against a build without the style (the red run).
    [ -n "${RING_BASE:-}" ] && sed -i '/style "swayward"/d; /ring-colors\|ring-wrong/d' "$XDG_RUNTIME_DIR/lock.kdl"
    return 0
}

t_ring_style() {
    local pid t0 mid r g b sig1 sig2 c rest moved after base woke ms
    # 8 points on the band (radius 80), 45 degrees apart: the spinner's comet spans a quarter
    # turn, so it always covers two of them, one at half alpha or more.
    local band=(242 120 219 177 162 200 105 177 82 120 105 63 162 40 219 63)

    # Crossfade: Escape turns the inside from the input blue to the clear red over ring-colors.
    ring_style_conf 'animations { ring-colors { duration-ms 800; curve "linear"; }; }'
    start_field "ring-style" || return
    sleep 0.5
    check "ring-style: idle inside" "$(pixel 162 80)" "0 0 255"
    base=$(wakeups "$pid" 2)
    [ "$base" -lt 10 ] && pass "ring-style: settled ring is idle ($base wakeups in 2 s)" \
        || fail "ring-style: settled ring wakes $base times in 2 s"
    $T wtype -s 300 -k Escape
    t0=$(date +%s%N)
    sleep_until "$t0" 300
    mid=$(pixel 162 80)
    r=$(echo "$mid" | cut -d' ' -f1)
    b=$(echo "$mid" | cut -d' ' -f3)
    { [ "$r" -gt 20 ] && [ "$r" -lt 235 ] && [ "$b" -gt 20 ] && [ "$b" -lt 235 ]; } \
        && pass "ring-style: inside mid-crossfade at ~0.3 s ($mid)" \
        || fail "ring-style: inside not mid-crossfade at ~0.3 s ($mid)"
    sleep_until "$t0" 1100
    check "ring-style: inside at the clear colour after the crossfade" "$(pixel 162 80)" "255 0 0"
    # Glow: just outside the stroke (outer edge at radius 86 with the border line), tinted.
    c=$(pixel 251 120 | cut -d' ' -f2)
    [ "$c" -gt 10 ] && pass "ring-style: glow outside the ring (green $c)" \
        || fail "ring-style: no glow outside the ring (green $c)"
    kill -USR1 "$pid"
    wait_exit "$pid"

    # glow 0: the same pixel is background.
    ring_style_conf
    sed -i 's/style "swayward"/style "swayward"; glow 0/' "$XDG_RUNTIME_DIR/lock.kdl"
    start_field "ring-style" || return
    sleep 0.5
    check "ring-style: glow 0 leaves the background" "$(pixel 251 120)" "0 0 0"
    kill -USR1 "$pid"
    wait_exit "$pid"

    # Spinner: test builds hold the verdict for 2 s; the comet moves a quarter turn in 300 ms.
    ring_style_conf
    SWAYWARDLOCK_TEST_AUTH_DELAY_MS=2000 RUST_LOG=swaywardlock=debug \
        "$BIN" --no-fade-in -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "ring-style: never locked"; cat "$LOG"; kill "$pid"; return; }
    $T wtype -s 300 x -k Return
    sleep 0.4
    sig1=$(pixels "${band[@]}")
    sleep 0.3
    sig2=$(pixels "${band[@]}")
    grep -q 'authentication failed' "$LOG" && fail "ring-style: the verdict came before the spinner samples" \
        || pass "ring-style: still verifying during the spinner samples"
    [ "$sig1" != "$sig2" ] && pass "ring-style: the spinner moves while verifying" \
        || fail "ring-style: the band did not change in 300 ms while verifying ($sig1)"
    # Once the verdict is in and the wrong state is over, nothing ticks.
    sleep 5.5
    woke=$(wakeups "$pid" 2)
    [ "$woke" -lt 10 ] && pass "ring-style: no ticker after verifying ($woke wakeups in 2 s)" \
        || fail "ring-style: $woke wakeups in 2 s after verifying"
    kill -USR1 "$pid"
    wait_exit "$pid"

    # Where the swaylock style centres the same ring.
    local swaylock_centre
    ring_style_conf
    sed -i '/style "swayward"/d' "$XDG_RUNTIME_DIR/lock.kdl"
    start_field "ring-style" || return
    sleep 0.3
    swaylock_centre=$(colour_centre2 "0 0 255" 120)
    kill -USR1 "$pid"
    wait_exit "$pid"

    # Wrong: the ring shakes, then rests where it was; the session stays locked.
    ring_style_conf 'animations { ring-colors { off; }; ring-wrong { duration-ms 3000; curve "linear"; }; }' \
        'general { fail-timeout-ms 5000; }'
    start_field "ring-style" || return
    sleep 0.3
    rest=$(colour_centre2 "0 0 255" 120)
    # The glow pads the texture; the ring stays centred where the swaylock style puts it.
    check "ring-style: the glow does not move the ring" "$rest" "$swaylock_centre"
    $T wtype -s 300 x -k Return
    # Sample only once the verdict is in: the inside is the wrong state's green (the shake moves
    # the ring by a few px, so this point stays inside it).
    # The flash tints it towards white at first, so match by channel (the input blue has no green).
    local wrong=no
    for _ in $(seq 40); do
        read -r r g b <<<"$(pixel 162 80)"
        if [ "$g" -ge 250 ] && [ "$r" -le 150 ] && [ "$b" -le 150 ]; then wrong=yes; break; fi
        sleep 0.05
    done
    check "ring-style: the wrong verdict reached the screen" "$wrong" yes
    moved=0
    for _ in $(seq 12); do
        c=$(colour_centre2 "0 255 0" 120)
        [ "$c" -ge 0 ] && [ $(( c > rest ? c - rest : rest - c )) -gt "$moved" ] \
            && moved=$(( c > rest ? c - rest : rest - c ))
    done
    # Offsets are doubled: 4 means 2 px. The shake is 0.08 * radius = 6.4 px at most.
    { [ "$moved" -ge 4 ] && [ "$moved" -le 16 ]; } \
        && pass "ring-style: the ring shakes on a wrong password (max $((moved / 2)) px)" \
        || fail "ring-style: no plausible shake on a wrong password (max offset $moved / 2 px, want 2..8)"
    sleep 3.5
    after=$(colour_centre2 "0 255 0" 120)
    check "ring-style: back at rest after the shake" "$after" "$rest"
    kill -0 "$pid" 2>/dev/null && pass "ring-style: still locked after a wrong password" \
        || fail "ring-style: exited after a wrong password"
    # Unlock while it shakes: exit 0, promptly (the default 200 ms fade-out, not the shake).
    $T wtype -s 300 x -k Return
    sleep 0.3
    t0=$(date +%s%N)
    kill -USR1 "$pid"
    wait_exit "$pid"
    check "ring-style: SIGUSR1 during the shake exits 0" "$?" 0
    ms=$(( ($(date +%s%N) - t0) / 1000000 ))
    [ "$ms" -lt 1500 ] && pass "ring-style: unlock during the shake took ${ms} ms" \
        || fail "ring-style: unlock during the shake took ${ms} ms"

    # The right password while the spinner runs: exit 0 once the verdict is in, promptly.
    ring_style_conf
    SWAYWARDLOCK_TEST_AUTH_DELAY_MS=1000 "$BIN" --no-fade-in -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "ring-style: never locked"; cat "$LOG"; kill "$pid"; return; }
    $T wtype -s 300 "$PASSWORD" -k Return
    t0=$(date +%s%N)
    wait_exit "$pid"
    check "ring-style: the password during the spinner exits 0" "$?" 0
    ms=$(( ($(date +%s%N) - t0) / 1000000 ))
    { [ "$ms" -ge 800 ] && [ "$ms" -lt 2500 ]; } && pass "ring-style: unlock after the delayed verdict took ${ms} ms" \
        || fail "ring-style: unlock after a 1 s verdict delay took ${ms} ms"

    # animations { off; }: the end state at once, even with a long ring-colors configured.
    ring_style_conf 'animations { off; ring-colors { duration-ms 2000; curve "linear"; }; }'
    start_field "ring-style" || return
    sleep 0.3
    $T wtype -s 300 -k Escape
    sleep 0.2
    check "ring-style: animations off, final colour right after the key" "$(pixel 162 80)" "255 0 0"
    kill -USR1 "$pid"
    wait_exit "$pid"
}

# Background post-processing after the blur: hyprlock's vibrancy, swayward's blur saturation and
# noise. A uniform colour is unchanged by the blur itself, so the expected colours are the maths
# alone: vibrancy 1 / darkness 0.05 on e67828 (230 120 40) is 255 116 15 (hyprlock FRAGBLUR1),
# saturation 0 is the Rec. 709 luma 138 (swayward postprocess.frag).
# Usage: vibrancy_lock NAME KDL-LINES...; leaves the locker running as $pid.
vibrancy_lock() {
    local name=$1
    shift
    printf '%s\n' "$@" 'animations { off; }' >"$XDG_RUNTIME_DIR/lock.kdl"
    "$BIN" -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "vibrancy: $name never locked"; cat "$LOG"; kill "$pid"; return 1; }
    sleep 0.3
}

# Pass if the centre pixel is within TOL of WANT on every channel (polls up to 3 s).
# Usage: check_near NAME "R G B" TOL
check_near() {
    local got ok=False
    for _ in $(seq 30); do
        got=$(pixel)
        ok=$(python3 -c 'import sys; g=sys.argv[1].split(); w=sys.argv[2].split(); t=int(sys.argv[3]); print(all(abs(int(a)-int(b))<=t for a,b in zip(g,w)))' "$got" "$2" "$3")
        [ "$ok" = True ] && break
        sleep 0.1
    done
    [ "$ok" = True ] && pass "$1 ($got)" || fail "$1 (got '$got', want $2 +-$3)"
}

t_vibrancy() {
    local pid
    vibrancy_lock boost 'background { color "#e67828"; blur { passes 1; noise 0; saturation 1; }; vibrancy 1.0; vibrancy-darkness 0.05; }' \
        && check_near "vibrancy: boosts the blurred colour like hyprlock" "255 116 15" 3
    kill -USR1 "$pid"; wait_exit "$pid"

    vibrancy_lock plain 'background { color "#e67828"; blur { passes 1; noise 0; saturation 1; }; }' \
        && check_colour "vibrancy: a uniform blur without post-processing keeps the colour" "230 120 40"
    kill -USR1 "$pid"; wait_exit "$pid"

    vibrancy_lock saturation 'background { color "#e67828"; blur { passes 1; noise 0; saturation 0; }; }' \
        && check_near "vibrancy: blur saturation 0 is grey (swayward)" "138 138 138" 3
    kill -USR1 "$pid"; wait_exit "$pid"

    vibrancy_lock noise 'background { color "#808080"; blur { passes 1; noise 0.2; saturation 1; }; }' && {
        local samples distinct
        samples=$(pixels 10 10 50 20 90 30 130 40 170 50 210 60 250 70 290 80 30 200 160 120)
        distinct=$(echo "$samples" | tr '|' '\n' | sort -u | wc -l)
        [ "$distinct" -ge 3 ] && pass "vibrancy: blur noise varies the pixels ($distinct distinct)" \
            || fail "vibrancy: blur noise had no effect ($samples)"
    }
    kill -USR1 "$pid"; wait_exit "$pid"

    # The read-back and re-upload keep the orientation: red stays on top of the test image.
    python3 "$HERE/ppm-pixel" --write-test-png "$XDG_RUNTIME_DIR/bg.png"
    vibrancy_lock orientation "background { path \"$XDG_RUNTIME_DIR/bg.png\"; fit \"fill\"; blur { passes 1; offset 1; noise 0; saturation 0.99; }; }" && {
        local top bottom
        top=$(pixel 160 10) bottom=$(pixel 160 230)
        check "vibrancy: post-processed image keeps red on top" \
            "$(python3 -c 'import sys; r,g,b=map(int,sys.argv[1:4]); R,G,B=map(int,sys.argv[4:]); print(r>200 and b<60 and B>200 and R<60)' $top $bottom)" True
    }
    kill -USR1 "$pid"; wait_exit "$pid"

    # Without blur the options do nothing (hyprlock, swayward), and the locker says so.
    vibrancy_lock no-blur 'background { color "#e67828"; vibrancy 1.0; }' && {
        check_colour "vibrancy: no effect without blur" "230 120 40"
        grep -q 'vibrancy.*needs blur' "$LOG" && pass "vibrancy: warns that it needs blur" \
            || fail "vibrancy: no warning without blur"
    }
    kill -USR1 "$pid"; wait_exit "$pid"
}

# Pixels in a box whose red channel is strictly between 30 and 225 with no green or blue: the
# blended edge of a red shape on black. Usage: partial_red X0 Y0 X1 Y1
partial_red() {
    $T grim -t ppm - | python3 -c '
import sys
x0, y0, x1, y1 = map(int, sys.argv[1:5])
data = sys.stdin.buffer.read()
parts, i = [], 0
while len(parts) < 4:
    while i < len(data) and data[i:i+1].isspace(): i += 1
    j = i
    while j < len(data) and not data[j:j+1].isspace(): j += 1
    parts.append(data[i:j]); i = j
i += 1
w = int(parts[1])
n = 0
for y in range(y0, y1):
    for x in range(x0, x1):
        r, g, b = data[i+(y*w+x)*3:i+(y*w+x)*3+3]
        n += 30 < r < 225 and g < 10 and b < 10
print(n)' "$@"
}

# Start the locker on $1 (black background, animations off, no fade-in) after checking that the
# config validates. Sets pid. Usage: start_rotate NAME CONFIG
start_rotate() {
    if ! $T "$BIN" validate -c "$2" >"$LOG" 2>&1; then
        fail "rotate: $1 config does not validate"
        cat "$LOG"
        return 1
    fi
    "$BIN" --no-fade-in -c "$2" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "rotate: $1 never locked"; cat "$LOG"; kill "$pid"; return 1; }
}

t_rotate() {
    local d="$XDG_RUNTIME_DIR" pid head='background { color "#000000"; }
animations { off; }'
    # 100x20 turned 90 degrees about its centre (160, 120): a 20x100 bar, x 150..170, y 70..170.
    printf '%s\n' "$head" 'shape { size 100 20; color "#ff0000"; corner-radius 0; rotate 90; }' >"$d/r90.kdl"
    if start_rotate "90" "$d/r90.kdl"; then
        check_colour "rotate: 90, top of the bar" "255 0 0" 160 80
        check_colour "rotate: 90, bottom of the bar" "255 0 0" 160 160
        check_colour "rotate: 90, right of the bar is empty" "0 0 0" 200 120
        check_colour "rotate: 90, left of the bar is empty" "0 0 0" 120 120
        kill -USR1 "$pid"; wait_exit "$pid"
    fi

    # Direction: 200x10 at 45 degrees. Counter-clockwise on screen puts the right end up: the
    # point 85 px from the centre along the turned axis is (160 + 60, 120 - 60) = (220, 60);
    # clockwise would put it at (220, 180).
    printf '%s\n' "$head" 'shape { size 200 10; color "#ff0000"; corner-radius 0; rotate 45; }' >"$d/r45.kdl"
    if start_rotate "45" "$d/r45.kdl"; then
        check_colour "rotate: 45, the right end is up (counter-clockwise)" "255 0 0" 220 60
        check_colour "rotate: 45, the left end is down" "255 0 0" 100 180
        check_colour "rotate: 45, nothing where clockwise would be" "0 0 0" 220 180
        kill -USR1 "$pid"; wait_exit "$pid"
    fi

    # Antialiasing: 200x20 at 30 degrees. The long edges cross pixels at an angle, so they must
    # blend (an aliased edge is all 255 or 0). Around 2 x 200 px of edge, roughly one blended
    # pixel per edge pixel step.
    printf '%s\n' "$head" 'shape { size 200 20; color "#ff0000"; corner-radius 0; rotate 30; }' >"$d/r30.kdl"
    if start_rotate "30" "$d/r30.kdl"; then
        check_colour "rotate: 30, centre" "255 0 0" 160 120
        local blended
        blended=$(partial_red 40 50 280 190)
        [ "$blended" -gt 100 ] && pass "rotate: 30, edges are antialiased ($blended blended pixels)" \
            || fail "rotate: 30, edges are not antialiased ($blended blended pixels)"
        kill -USR1 "$pid"; wait_exit "$pid"
    fi

    # Image: the test PNG (red top, blue bottom) at 60 px, centred, x 130..190, y 90..150.
    # Turned 90 degrees counter-clockwise, the red half is on the left.
    python3 "$HERE/ppm-pixel" --write-test-png "$d/face.png"
    printf '%s\n' "$head" "image { path \"$d/face.png\"; size 60; corner-radius 0; rotate 90; }" >"$d/img.kdl"
    if start_rotate "image" "$d/img.kdl"; then
        check_colour "rotate: image, red half on the left" "255 0 0" 145 120
        check_colour "rotate: image, blue half on the right" "0 0 255" 175 120
        kill -USR1 "$pid"; wait_exit "$pid"
    fi

    # Label: unrotated "MMMMMMMM" is wide and short; turned 90 degrees it is narrow and runs
    # from above to below the centre.
    local label='label { text "MMMMMMMM"; font "Sans Bold 20"; color "#ffffff"; ROT }' flat tall top bottom
    printf '%s\n' "$head" "${label/ROT/}" >"$d/l0.kdl"
    if start_rotate "label 0" "$d/l0.kdl"; then
        flat=$(settled_width "255 255 255" 0 0 320 240)
        kill -USR1 "$pid"; wait_exit "$pid"
    fi
    printf '%s\n' "$head" "${label/ROT/rotate 90;}" >"$d/l90.kdl"
    if start_rotate "label 90" "$d/l90.kdl"; then
        tall=$(settled_width "255 255 255" 0 0 320 240)
        top=$(colour_width "255 255 255" 0 60 320 70)
        bottom=$(colour_width "255 255 255" 0 170 320 180)
        { [ "${flat:-0}" -gt 120 ] && [ "$tall" -gt 0 ] && [ "$tall" -lt 45 ] \
            && [ "$top" -gt 0 ] && [ "$bottom" -gt 0 ]; } \
            && pass "rotate: label turned upright (width $flat -> $tall, rows 60 and 170 lit)" \
            || fail "rotate: label not turned (width $flat -> $tall, row 60: $top, row 170: $bottom)"
        kill -USR1 "$pid"; wait_exit "$pid"
    fi

    # Edge alignment (hyprlock): against the left and top edges, the turned bounding box touches
    # them, inset by hyprlock's 1 px antialiasing margin: the bar covers x 1..21, y 1..101.
    printf '%s\n' "$head" 'shape { size 100 20; color "#ff0000"; corner-radius 0; rotate 90; halign "left"; valign "top"; position 0 0; }' >"$d/edge.kdl"
    if start_rotate "edge" "$d/edge.kdl"; then
        check_colour "rotate: edge, the bar is in the left column" "255 0 0" 5 50
        check_colour "rotate: edge, right of the bar is empty" "0 0 0" 25 50
        check_colour "rotate: edge, the bar reaches the top" "255 0 0" 5 5
        check_colour "rotate: edge, the bar ends at y 101" "0 0 0" 5 105
        kill -USR1 "$pid"; wait_exit "$pid"
    fi

    # Shadows turn with the shape. A 4 px spread with no blur makes a green band around the box:
    # unrotated, the box is x 110..210, y 110..130, so 2 px above its top edge, (200, 108), is
    # green. Turned 90 degrees the box is x 150..170, y 70..170: the band is 2 px outside its
    # long sides at mid-height, (148, 120) and (172, 120), and (200, 108) is empty.
    local sh='shape { size 100 20; color "#ff0000"; corner-radius 0; ROT shadow { softness 0; spread 4; offset x=0 y=0; color "#00ff00"; }; }'
    printf '%s\n' "$head" "${sh/ROT/}" >"$d/sh0.kdl"
    if start_rotate "shadow 0" "$d/sh0.kdl"; then
        check_colour "rotate: shadow 0, green above the box" "0 255 0" 200 108
        check_colour "rotate: shadow 0, no green beside the box" "0 0 0" 148 140
        kill -USR1 "$pid"; wait_exit "$pid"
    fi
    printf '%s\n' "$head" "${sh/ROT/rotate 90;}" >"$d/sh90.kdl"
    if start_rotate "shadow 90" "$d/sh90.kdl"; then
        check_colour "rotate: shadow 90, green left of the bar" "0 255 0" 148 120
        check_colour "rotate: shadow 90, green right of the bar" "0 255 0" 172 120
        check_colour "rotate: shadow 90, no unrotated shadow left behind" "0 0 0" 200 108
        kill -USR1 "$pid"; wait_exit "$pid"
    fi

    # rotate 0 is the unrotated path: the same pixels, antialiased corners and border included.
    local plain='shape { size 100 40; color "#ff0000"; corner-radius 15; border { width 3; color "#00ff00"; }; ROT }'
    local pts=(160 120 108 100 109 101 112 103) a=() b=() i
    printf '%s\n' "$head" "${plain/ROT/}" >"$d/p.kdl"
    printf '%s\n' "$head" "${plain/ROT/rotate 0;}" >"$d/p0.kdl"
    if start_rotate "plain" "$d/p.kdl"; then
        check_colour "rotate: plain shape drawn" "255 0 0" 160 120
        for ((i = 0; i < ${#pts[@]}; i += 2)); do a+=("$(pixel "${pts[i]}" "${pts[i+1]}")"); done
        kill -USR1 "$pid"; wait_exit "$pid"
    fi
    if start_rotate "rotate 0" "$d/p0.kdl"; then
        check_colour "rotate: rotate 0 shape drawn" "255 0 0" 160 120
        for ((i = 0; i < ${#pts[@]}; i += 2)); do b+=("$(pixel "${pts[i]}" "${pts[i+1]}")"); done
        kill -USR1 "$pid"; wait_exit "$pid"
    fi
    check "rotate: rotate 0 is pixel-identical to no rotate" "${b[*]}" "${a[*]}"

    # Fractional scale 1.5: the 213x160 logical output centres the bar at physical (160, 120);
    # 20x100 logical is 30x150 physical, x 145..175, y 45..195.
    swaymsg_ output HEADLESS-1 scale 1.5 >/dev/null
    if start_rotate "scale 1.5" "$d/r90.kdl"; then
        check_colour "rotate: scale 1.5, top of the bar" "255 0 0" 160 55
        check_colour "rotate: scale 1.5, inside the bar's right side" "255 0 0" 172 120
        check_colour "rotate: scale 1.5, right of the bar is empty" "0 0 0" 180 120
        kill -USR1 "$pid"; wait_exit "$pid"
    fi
    # The offscreen texture is checked against the GPU limit (16384 px on llvmpipe): at scale 2 a
    # 10000 px shape is skipped with a warning, the background and other widgets still draw.
    swaymsg_ output HEADLESS-1 scale 2 >/dev/null
    printf '%s\n' 'background { color "#204060"; }' 'animations { off; }' \
        'shape { size 10000 10; color "#ff0000"; rotate 30; }' \
        'shape { size 20 20; color "#00ff00"; corner-radius 0; halign "left"; valign "top"; rotate 45; position 10 -10; }' \
        >"$d/huge.kdl"
    if start_rotate "huge" "$d/huge.kdl"; then
        check_colour "rotate: oversized shape skipped, background drawn" "32 64 96" 300 220
        check_colour "rotate: oversized shape skipped, small rotated shape drawn" "0 255 0" 50 50
        grep -q 'shape: rotated:.*GPU texture limit' "$LOG" && pass "rotate: oversized offscreen texture is logged" \
            || { fail "rotate: oversized offscreen texture not logged"; cat "$LOG"; }
        kill -USR1 "$pid"; wait_exit "$pid"
    fi
    swaymsg_ output HEADLESS-1 scale 1 >/dev/null

    # xray ignores rotate (hyprlock), with a warning. The 100x20 cut-out stays at x 110..210 with
    # its 4 px border around it; turned, the border's right side would be at x 170..174.
    printf '%s\n' "$head" \
        'shape { size 100 20; xray; corner-radius 0; rotate 90; border { width 4; color "#00ff00"; }; }' >"$d/xray.kdl"
    if start_rotate "xray" "$d/xray.kdl"; then
        check_colour "rotate: xray stays unrotated (border right of the cut-out)" "0 255 0" 212 120
        check_colour "rotate: xray stays unrotated (no border above the centre)" "0 0 0" 160 80
        grep -q 'xray.*rotate\|rotate.*xray' "$LOG" && pass "rotate: xray + rotate warns" \
            || fail "rotate: xray + rotate gives no warning"
        kill -USR1 "$pid"; wait_exit "$pid"
    fi
}

# Where the text and its red shadow are on screen: the white text's bounding box, and the
# red-dominant pixels (R > 120, G < 80, B < 80) within 20 px of it. Prints
#   "RED_COUNT MEAN_X MEAN_Y RED_W RED_H WHITE_X0 WHITE_Y0 WHITE_X1 WHITE_Y1"
# (all 0 when nothing is white). Usage: shadow_stats
shadow_stats() {
    $T grim -t ppm - | python3 -c '
import sys
data = sys.stdin.buffer.read()
parts, i = [], 0
while len(parts) < 4:
    while i < len(data) and data[i:i+1].isspace(): i += 1
    j = i
    while j < len(data) and not data[j:j+1].isspace(): j += 1
    if j == i: sys.exit("shadow_stats: empty or truncated PPM")
    parts.append(data[i:j]); i = j
i += 1
w, h = int(parts[1]), int(parts[2])
px = lambda x, y: data[i+(y*w+x)*3:i+(y*w+x)*3+3]
white = [(x, y) for y in range(h) for x in range(w) if min(px(x, y)) > 200]
if not white:
    print("0 0 0 0 0 0 0 0 0"); sys.exit()
x0, x1 = min(p[0] for p in white), max(p[0] for p in white)
y0, y1 = min(p[1] for p in white), max(p[1] for p in white)
red = [(x, y) for y in range(max(0, y0-20), min(h, y1+21)) for x in range(max(0, x0-20), min(w, x1+21))
       if px(x, y)[0] > 120 and px(x, y)[1] < 80 and px(x, y)[2] < 80]
if not red:
    print(f"0 0 0 0 0 {x0} {y0} {x1} {y1}"); sys.exit()
rx = [p[0] for p in red]; ry = [p[1] for p in red]
print(len(red), f"{sum(rx)/len(rx):.2f}", f"{sum(ry)/len(ry):.2f}", max(rx)-min(rx)+1, max(ry)-min(ry)+1, x0, y0, x1, y1)'
}

# shadow_stats once the first frame is on screen (two equal samples in a row with text drawn).
settled_shadow() {
    local s prev=""
    for _ in $(seq 30); do
        s=$(shadow_stats)
        [ "${s##0 0 0 0 0 0 0 0 0}" != "" ] && [ "$s" = "$prev" ] && break
        prev=$s
        sleep 0.1
    done
    echo "$s"
}

# Start the locker on a label config; sets pid. Usage: start_shadow NAME BLOCK [EXTRA]
start_shadow() {
    local cfg="$XDG_RUNTIME_DIR/shadow-$1.kdl"
    printf '%s\n' 'background { color "#000000"; }' 'animations { off; }' \
        "label { text \"MMMM\"; font \"Sans Bold 40\"; color \"#ffffff\"; ${2:+$2;} ${3:+$3;} }" >"$cfg"
    if ! $T "$BIN" validate -c "$cfg" >"$LOG" 2>&1; then
        fail "text-shadow: $1 config does not validate"
        cat "$LOG"
        return 1
    fi
    "$BIN" --no-fade-in -c "$cfg" >"$LOG" 2>&1 &
    pid=$!
    wait_locked "$LOG" || { fail "text-shadow: $1 never locked"; cat "$LOG"; kill "$pid"; return 1; }
}

t_text_shadow() {
    local d="$XDG_RUNTIME_DIR" pid base shadow moved up
    local blk='text-shadow { passes 2; size 3; color "#ff0000"; }'

    # Control: no block, then passes 0 (off). No red anywhere, and the text is where it was.
    if start_shadow plain ""; then
        base=$(settled_shadow)
        local plain_px; plain_px="$(pixel 160 120)|$(pixel 140 118)|$(pixel 100 120)"
        kill -USR1 "$pid"; wait_exit "$pid"
    fi
    set -- $base
    [ "${1:-1}" = 0 ] && [ "${6:-0}" -gt 0 ] && pass "text-shadow: no block, no red (white text x $6..$8)" \
        || fail "text-shadow: control has red or no text ($base)"
    if start_shadow off 'text-shadow { passes 0; size 3; color "#ff0000"; }'; then
        local off; off=$(settled_shadow)
        local off_px; off_px="$(pixel 160 120)|$(pixel 140 118)|$(pixel 100 120)"
        kill -USR1 "$pid"; wait_exit "$pid"
        check "text-shadow: passes 0 draws no shadow and moves nothing" "$off" "$base"
        check "text-shadow: passes 0 is pixel-identical to no block (3 points)" "$off_px" "$plain_px"
    fi

    # Shadow on: red pixels around the white text (the text covers its own shadow's middle).
    if start_shadow on "$blk"; then
        shadow=$(settled_shadow)
        set -- $shadow
        [ "$1" -gt 50 ] && pass "text-shadow: red shadow around the text ($1 red px, mean x $2, text x $6..$8)" \
            || fail "text-shadow: no red shadow ($shadow)"
        [ "$6" = "$(echo $base | cut -d' ' -f6)" ] && [ "$8" = "$(echo $base | cut -d' ' -f8)" ] \
            && pass "text-shadow: the text itself did not move" || fail "text-shadow: text moved ($shadow vs $base)"
        kill -USR1 "$pid"; wait_exit "$pid"
    fi

    # offset x=10: the red mass moves right by about 10 px (the text hides part of it).
    if start_shadow right 'text-shadow { passes 2; size 3; color "#ff0000"; offset x=10 y=0; }'; then
        moved=$(settled_shadow)
        kill -USR1 "$pid"; wait_exit "$pid"
        local dx
        dx=$(python3 -c 'import sys; a=sys.argv[1].split(); b=sys.argv[2].split(); print(round(float(b[1])-float(a[1]), 2))' "$shadow" "$moved")
        [ "$(python3 -c 'import sys; print(8 <= float(sys.argv[1]) <= 12)' "$dx")" = True ] \
            && pass "text-shadow: offset x=10 moves the red mass right by $dx px" \
            || fail "text-shadow: offset x=10 moved the mean x by $dx px ($shadow vs $moved)"
    fi
    # offset y=10 moves it up (positive y is up, as in position): the mean y falls.
    if start_shadow up 'text-shadow { passes 2; size 3; color "#ff0000"; offset x=0 y=10; }'; then
        up=$(settled_shadow)
        kill -USR1 "$pid"; wait_exit "$pid"
        local dy
        dy=$(python3 -c 'import sys; a=sys.argv[1].split(); b=sys.argv[2].split(); print(round(float(a[2])-float(b[2]), 2))' "$shadow" "$up")
        [ "$(python3 -c 'import sys; print(8 <= float(sys.argv[1]) <= 12)' "$dy")" = True ] \
            && pass "text-shadow: offset y=10 moves the red mass up by $dy px" \
            || fail "text-shadow: offset y=10 moved the mean y up by $dy px ($shadow vs $up)"
    fi

    # A bigger blur spreads the red wider; boost 0 draws nothing.
    if start_shadow big 'text-shadow { passes 3; size 6; color "#ff0000"; boost 10; }'; then
        local big; big=$(settled_shadow)
        kill -USR1 "$pid"; wait_exit "$pid"
        set -- $big; local bw=$4
        set -- $shadow
        [ "$bw" -gt "$4" ] && pass "text-shadow: passes 3 size 6 reaches wider ($bw px, was $4)" \
            || fail "text-shadow: bigger blur not wider ($big vs $shadow)"
    fi
    if start_shadow zero 'text-shadow { passes 2; size 3; color "#ff0000"; boost 0; }'; then
        local zero; zero=$(settled_shadow)
        kill -USR1 "$pid"; wait_exit "$pid"
        set -- $zero
        [ "$1" = 0 ] && pass "text-shadow: boost 0 draws no red" || fail "text-shadow: boost 0 drew red ($zero)"
    fi

    # Rotated 90 degrees the label is tall and so is its shadow: the red mass is taller than wide
    # (unrotated it is wider than tall), and it surrounds the turned text.
    set -- $shadow
    [ "$4" -gt "$5" ] && pass "text-shadow: unrotated red mass is wide ($4 x $5)" \
        || fail "text-shadow: unrotated red mass not wide ($shadow)"
    if start_shadow rot "$blk" 'rotate 90'; then
        local rot; rot=$(settled_shadow)
        kill -USR1 "$pid"; wait_exit "$pid"
        set -- $rot
        { [ "$1" -gt 50 ] && [ "$5" -gt "$4" ]; } \
            && pass "text-shadow: rotate 90, the red mass is tall ($4 x $5, $1 px)" \
            || fail "text-shadow: rotate 90, red mass not tall ($rot)"
    fi

    # The shadow is rendered again when the text changes (a command label).
    echo MM >"$d/shadow-text"
    printf '%s\n' 'background { color "#000000"; }' 'animations { off; }' \
        "label { text \"cmd[update:300] cat $d/shadow-text\"; font \"Sans Bold 40\"; color \"#ffffff\"; $blk; }" >"$d/shadow-cmd.kdl"
    "$BIN" --no-fade-in -c "$d/shadow-cmd.kdl" >"$LOG" 2>&1 &
    pid=$!
    if wait_locked "$LOG"; then
        local before after
        before=$(settled_shadow)
        echo MMMM >"$d/shadow-text"
        sleep 1
        after=$(settled_shadow)
        set -- $before; local nb=$1 wb=$4
        set -- $after
        [ "$4" -gt "$wb" ] && [ "$1" -gt "$nb" ] \
            && pass "text-shadow: the shadow follows a changed text (width $wb -> $4, $nb -> $1 px)" \
            || fail "text-shadow: the shadow did not follow the text ($before -> $after)"
        # A relayout keeps the cached shadow, and it is still drawn (at the new place).
        swaymsg_ output HEADLESS-1 resolution 400x300 >/dev/null
        sleep 0.5
        local relaid; relaid=$(settled_shadow)
        swaymsg_ output HEADLESS-1 resolution 320x240 >/dev/null
        set -- $relaid
        { [ "$1" -gt 50 ] && [ "$6" -gt "$(echo $after | cut -d' ' -f6)" ]; } \
            && pass "text-shadow: after a relayout the shadow is drawn ($1 red px, text x $6..$8)" \
            || fail "text-shadow: no shadow after a relayout ($relaid, was $after)"
        kill -USR1 "$pid"; wait_exit "$pid"
    else
        fail "text-shadow: cmd label never locked"; cat "$LOG"; kill "$pid"
    fi

    # size 0 still blurs (the down/up chain spreads about 2^passes px): the shadow fades out
    # inside its texture, with no hard edge where the texture ends. Along the middle row, from
    # the left until the text starts, the red never jumps (the old margin cut it 0 -> 94).
    if start_shadow soft 'text-shadow { passes 3; size 0; color "#ff0000"; boost 1; }'; then
        local soft; soft=$(settled_shadow)
        local edge
        edge=$($T grim -t ppm - | python3 -c '
import sys
data = sys.stdin.buffer.read()
parts, i = [], 0
while len(parts) < 4:
    while i < len(data) and data[i:i+1].isspace(): i += 1
    j = i
    while j < len(data) and not data[j:j+1].isspace(): j += 1
    parts.append(data[i:j]); i = j
i += 1
w, h = int(parts[1]), int(parts[2])
px = lambda x, y: data[i+(y*w+x)*3:i+(y*w+x)*3+3]
y = int(sys.argv[1])
reds = []
for x in range(w):
    r, g, b = px(x, y)
    if g > 40: break
    reds.append(r)
first = next((v for v in reds if v), 0)
print(max(reds), first, max(abs(a - b) for a, b in zip(reds, reds[1:])))' "$(( ($(echo $soft | cut -d' ' -f7) + $(echo $soft | cut -d' ' -f9)) / 2 ))")
        kill -USR1 "$pid"; wait_exit "$pid"
        set -- $edge
        { [ "$1" -gt 40 ] && [ "$3" -le 24 ]; } \
            && pass "text-shadow: size 0 is soft, no hard edge (peak red $1, first $2, largest step $3)" \
            || fail "text-shadow: size 0 shadow has a hard edge or none (peak, first, step: $edge)"
    fi

    # The worst shadow the config accepts (passes 4, size 20) at scale 2, on a label whose text
    # changes: blurred on at most 2^19 px (reduced resolution; at full resolution the margin alone
    # makes it about 2900 x 2700), so the lock stays responsive, and blurred again only when the text or the
    # scale changed, not on a relayout. The shadow itself is too diffuse to count red here.
    local file="$d/shadow-worst"
    echo MM >"$file"
    printf '%s\n' 'background { color "#000000"; }' 'animations { off; }' \
        "label { text \"cmd[update:300] cat $file\"; font \"Sans Bold 40\"; color \"#ffffff\"; text-shadow { passes 4; size 20; color \"#ff0000\"; boost 10; }; }" \
        >"$d/shadow-worst.kdl"
    swaymsg_ output HEADLESS-1 scale 2 >/dev/null
    RUST_LOG=swaywardlock=debug "$BIN" --no-fade-in -c "$d/shadow-worst.kdl" >"$LOG" 2>&1 &
    pid=$!
    if wait_locked "$LOG"; then
        local worst sizes
        worst=$(settled_shadow)
        set -- $worst
        [ "$8" -gt "$6" ] && pass "text-shadow: worst config draws the text" \
            || fail "text-shadow: worst config, no text ($worst)"
        echo MMMM >"$file"
        sleep 1
        # A relayout with the same text and scale reuses the shadow.
        swaymsg_ output HEADLESS-1 resolution 400x300 >/dev/null
        sleep 1
        sizes=$(grep -o 'text shadow: [0-9]\+x[0-9]\+ px' "$LOG" | grep -o '[0-9]\+x[0-9]\+' | tr '\n' ' ')
        check "text-shadow: blurred once per text, not again on a relayout" "$(echo $sizes | wc -w)" 2
        local big=""
        for wh in $sizes; do
            [ $(( ${wh%x*} * ${wh#*x} )) -le 524288 ] || big="$big $wh"
        done
        [ -n "$sizes" ] && [ -z "$big" ] \
            && pass "text-shadow: worst config blurs at most 2^19 px ($sizes)" \
            || fail "text-shadow: worst config blurred an unbounded texture (${big:-no size logged})"
        local hwm t0
        hwm=$(awk '/VmHWM/ {print $2}' "/proc/$pid/status")
        t0=$(date +%s%N)
        kill -USR1 "$pid"
        wait_exit "$pid"
        check "text-shadow: worst config exits on SIGUSR1" "$?" 0
        pass "text-shadow: worst config, SIGUSR1 to exit $(( ($(date +%s%N) - t0) / 1000000 )) ms, peak RSS $hwm kB"
    else
        fail "text-shadow: worst config never locked"; cat "$LOG"; kill "$pid"
    fi
}

t_immediate_render() {
    # --immediate-render skips image decoding (synchronous, before lock): the colour shows.
    python3 "$HERE/ppm-pixel" --write-test-png "$XDG_RUNTIME_DIR/bg.png"
    echo "background { color \"#204060\"; path \"$XDG_RUNTIME_DIR/bg.png\"; fit \"fill\"; }" \
        >"$XDG_RUNTIME_DIR/lock.kdl"
    "$BIN" --immediate-render -c "$XDG_RUNTIME_DIR/lock.kdl" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || { fail "immediate render: never locked"; kill "$pid"; return; }
    check_colour "immediate render: the image is skipped, the colour drawn" "32 64 96" 160 10
    kill -USR1 "$pid"
    wait_exit "$pid"
}

t_second_locker() {
    RUST_LOG=swaywardlock=debug "$BIN" >"$LOG" 2>&1 &
    local pid=$!
    wait_locked "$LOG" || fail "second locker: first never locked"
    $T "$BIN" >"$XDG_RUNTIME_DIR/second.log" 2>&1
    check "second locker: exit code" "$?" 2
    kill -0 "$pid" 2>/dev/null && pass "second locker: first stays locked" \
        || fail "second locker: first exited"
    kill -USR1 "$pid"
    wait_exit "$pid"
}

# Start "$BIN" -v with stderr on a channel that breaks once the session is locked, then wait for
# the break. MODE: fifo (the reader exits: EPIPE), sock (a stream socket whose peer closes, as
# a journald stream can: EPIPE) or pty (the master closes: EIO, a closed terminal). Sets pid (the locker) and helper (its python parent, which writes the locker's exit
# status, 128 + signal if killed, to stderr.rc). The log up to "session locked" lands in $LOG.
broken_stderr_start() {
    local mode=$1 d="$XDG_RUNTIME_DIR"
    rm -f "$d/stderr.pid" "$d/stderr.closed" "$d/stderr.rc"
    python3 - "$mode" "$d" "$LOG" "$BIN" <<'PYEOF' &
import os, pty, socket, subprocess, sys
mode, d, log, binary = sys.argv[1:5]
if mode == "fifo":
    r, w = os.pipe()
elif mode == "sock":
    a, b = socket.socketpair(socket.AF_UNIX, socket.SOCK_STREAM)
    r, w = a.detach(), b.detach()
else:
    r, w = pty.openpty()
p = subprocess.Popen([binary, "-v"], stdout=subprocess.DEVNULL, stderr=w, start_new_session=True)
os.close(w)
open(f"{d}/stderr.pid", "w").write(str(p.pid))
buf = b""
with open(log, "ab") as out:
    while b"session locked" not in buf:
        try:
            chunk = os.read(r, 65536)
        except OSError:
            break
        if not chunk:
            break
        out.write(chunk)
        out.flush()
        buf = buf[-64:] + chunk
os.close(r)
open(f"{d}/stderr.closed", "w").close()
rc = p.wait()
open(f"{d}/stderr.rc", "w").write(str(rc if rc >= 0 else 128 - rc))
PYEOF
    helper=$!
    for _ in $(seq 50); do [ -e "$d/stderr.closed" ] && break; sleep 0.1; done
    pid=$(cat "$d/stderr.pid" 2>/dev/null)
    [ -e "$d/stderr.closed" ] && [ -n "$pid" ]
}

t_broken_stderr() {
    # stderr breaks after lock: a pipe or socket whose reader goes away (EPIPE) or a terminal
    # that is closed (EIO). Every later log line fails to write; it must be dropped, not abort the locker,
    # which left the session locked with nothing to type into (exit 134). Verbose, so every key
    # logs.
    local mode what helper
    for mode in fifo sock pty; do
        broken_stderr_start "$mode" || { fail "broken stderr ($mode): never locked"; cat "$LOG"; return; }
        sleep 0.2
        $T wtype -s 300 wrong -k Return
        sleep 1
        kill -USR2 "$pid"
        sleep 0.3
        alive "$pid" && pass "broken stderr ($mode): a wrong password and SIGUSR2 keep the locker alive" \
            || fail "broken stderr ($mode): the locker died on a log write"
        if [ "$mode" != pty ]; then
            $T wtype -s 300 "$PASSWORD" -k Return
            what="password"
        else
            # The "unlocking on SIGUSR1" line once aborted before the unlock.
            kill -USR1 "$pid"
            what="SIGUSR1"
        fi
        for _ in $(seq 50); do alive "$pid" || break; sleep 0.1; done
        alive "$pid" && kill -9 "$pid"
        wait "$helper"
        check "broken stderr ($mode): $what unlocks, exit code" "$(cat "$XDG_RUNTIME_DIR/stderr.rc")" 0
    done
}

t_no_display() {
    WAYLAND_DISPLAY=does-not-exist $T "$BIN" >"$LOG" 2>&1
    check "no display: exit code" "$?" 1
}

