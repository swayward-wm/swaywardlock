t_field_dots() {
    cat >"$XDG_RUNTIME_DIR/lock.kdl" <<'EOF'
background { color "#000000"; }
animations { input-field-dots { duration-ms 2000; curve "linear"; }; }
input-field {
    size 200 50
    inner-color "#ffffff"
    font-color "#000000"
    outline { width 4; color "#0000ff"; }
