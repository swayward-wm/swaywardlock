#!/usr/bin/env python3
"""A fake fprintd for tests: net.reactivated.Fprint on whatever bus DBUS_SYSTEM_BUS_ADDRESS names.

    fake-fprintd STATUS...

After VerifyStart it replays the given VerifyStatus results, one every 0.4 s, e.g.
`fake-fprintd verify-no-match verify-match`. It logs Claim/VerifyStart/VerifyStop/Release to
stdout so tests can check the device was released. It also owns org.freedesktop.login1, so the
locker's PrepareForSleep handling runs (and a forged one can be told apart from ours).

A status with a `+sleep` suffix (`verify-no-match+sleep`) is followed 0.1 s later by logind's
PrepareForSleep(true) and 2 s later by PrepareForSleep(false), logged as SLEEP and WAKE.
`+quicksleep` wakes after 0.4 s instead, inside a 1 s retry delay.

Like fprintd (device.c can_start_action), a VerifyStart while a verify session is open, that is
until VerifyStop, fails with net.reactivated.Fprint.Error.AlreadyInUse (logged as REFUSED), and
one before Claim fails with net.reactivated.Fprint.Error.ClaimDevice (logged as REFUSED too).

The status `sleepnow` sends PrepareForSleep(true) at once (and false 2 s later), and the next
status follows 0.4 s later, while asleep. A first argument `preparing` makes logind's
PreparingForSleep property true at start, with the wake signal 1 s later.

The status `finger-present` is not a VerifyStatus: it sets the device's finger-present property
(PropertiesChanged), as fprintd does when a finger touches the reader, and the next status
follows 0.4 s later. `pause` sends nothing and waits 2 s before the next status.

Log lines after "ready" start with the milliseconds since the fake started, e.g.
"1234 VerifyStart any", so a test can check the delays between steps.
"""

import sys
import time

import dbus
import dbus.service
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib

DEVICE_PATH = "/net/reactivated/Fprint/Device/0"
DEV = "net.reactivated.Fprint.Device"
T0 = time.monotonic()


class Manager(dbus.service.Object):
    @dbus.service.method("net.reactivated.Fprint.Manager", out_signature="o")
    def GetDefaultDevice(self):
        return dbus.ObjectPath(DEVICE_PATH)


class Logind(dbus.service.Object):
    preparing = False

    @dbus.service.method("org.freedesktop.DBus.Properties", in_signature="ss", out_signature="v")
    def Get(self, iface, name):
        return dbus.Boolean(self.preparing)

    @dbus.service.signal("org.freedesktop.login1.Manager", signature="b")
    def PrepareForSleep(self, starting):
        pass


class Device(dbus.service.Object):
    def __init__(self, bus, statuses, logind):
        super().__init__(bus, DEVICE_PATH)
        self.statuses = list(statuses)
        self.logind = logind
        self.verifying = False
        self.claimed = False
        if self.statuses and self.statuses[0] == "preparing":
            # logind is already preparing for sleep when the locker starts; wake after 1 s.
            self.statuses.pop(0)
            logind.preparing = True
            GLib.timeout_add(1000, self.wake)

    def wake(self):
        self.logind.preparing = False
        return self.sleep(False)

    def log(self, what):
        print(int((time.monotonic() - T0) * 1000), what, flush=True)

    @dbus.service.method(DEV, in_signature="s")
    def Claim(self, user):
        self.claimed = True
        self.log("Claim")

    @dbus.service.method(DEV)
    def Release(self):
        self.claimed = False
        self.log("Release")

    @dbus.service.method(DEV, in_signature="s")
    def VerifyStart(self, finger):
        if not self.claimed:
            self.log("VerifyStart REFUSED ClaimDevice")
            raise dbus.exceptions.DBusException(
                "Device was not claimed before use", name="net.reactivated.Fprint.Error.ClaimDevice"
            )
        if self.verifying:
            self.log("VerifyStart REFUSED AlreadyInUse")
            raise dbus.exceptions.DBusException(
                "Verification already in progress", name="net.reactivated.Fprint.Error.AlreadyInUse"
            )
        self.verifying = True
        self.log("VerifyStart " + finger)
        if self.statuses:
            status = self.statuses.pop(0)
            GLib.timeout_add(400, self.emit, status)

    @dbus.service.method(DEV)
    def VerifyStop(self):
        self.verifying = False
        self.log("VerifyStop")

    def sleep(self, starting):
        self.log("SLEEP" if starting else "WAKE")
        self.logind.PrepareForSleep(starting)
        return False

    def emit(self, status):
        if status == "pause":
            if self.statuses:
                GLib.timeout_add(2000, self.emit, self.statuses.pop(0))
            return False
        if status == "sleepnow":
            # Sleep now, wake after 2 s; the next status (a match, say) arrives while asleep.
            self.sleep(True)
            GLib.timeout_add(2000, self.sleep, False)
            if self.statuses:
                GLib.timeout_add(400, self.emit, self.statuses.pop(0))
            return False
        if status == "finger-present":
            self.log("finger-present")
            self.PropertiesChanged(DEV, {"finger-present": dbus.Boolean(True)}, dbus.Array([], signature="s"))
            if self.statuses:
                GLib.timeout_add(400, self.emit, self.statuses.pop(0))
            return False
        status, _, then = status.partition("+")
        if then in ("sleep", "quicksleep"):
            GLib.timeout_add(100, self.sleep, True)
            GLib.timeout_add(2000 if then == "sleep" else 400, self.sleep, False)
        self.log("status " + status)
        done = status in ("verify-match", "verify-no-match")
        # The verify session stays open after a final status, until VerifyStop.
        self.VerifyStatus(status, done)
        # Like fprintd, retry statuses keep the scan going: send the next one without waiting
        # for another VerifyStart.
        if not done and self.statuses:
            GLib.timeout_add(400, self.emit, self.statuses.pop(0))
        return False

    @dbus.service.signal(DEV, signature="sb")
    def VerifyStatus(self, result, done):
        pass

    @dbus.service.signal("org.freedesktop.DBus.Properties", signature="sa{sv}as")
    def PropertiesChanged(self, iface, changed, invalidated):
        pass


def main():
    DBusGMainLoop(set_as_default=True)
    bus = dbus.bus.BusConnection(__import__("os").environ["DBUS_SYSTEM_BUS_ADDRESS"])
    name = dbus.service.BusName("net.reactivated.Fprint", bus)
    logind = dbus.service.BusName("org.freedesktop.login1", bus)
    Manager(bus, "/net/reactivated/Fprint/Manager")
    Device(bus, sys.argv[1:], Logind(bus, "/org/freedesktop/login1"))
    print("ready", flush=True)
    GLib.MainLoop().run()
    del name, logind


if __name__ == "__main__":
    main()
