class ConfError(ValueError):
    """A value hyprlock would reject; the key keeps hyprlock's default."""


# ---- hyprlang value types (hyprlock MiscFunctions.cpp configStringToInt, ConfigManager.cpp) ----


def c_stof(s: str) -> float:
    """C++ std::stof: a numeric prefix is enough; past float range it throws."""
    m = re.match(r"\s*[+-]?(\d+\.?\d*|\.\d+)([eE][+-]?\d+)?", s)
    if not m:
        raise ConfError(f"cannot parse {s!r} as a number")
    v = float(m.group(0))
    if abs(v) > 3.4028234663852886e38:  # FLT_MAX
        raise ConfError(f"{m.group(0).strip()} is out of range for a float")
    return v


def c_stoi(s: str) -> int:
    m = re.match(r"\s*[+-]?\d+", s)
    if not m:
        raise ConfError(f"cannot parse {s!r} as an integer")
    return int(m.group(0))


def parse_hex(s: str) -> int:
    try:
        return int(s, 16)
    except ValueError:
        raise ConfError(f"invalid hex {s!r}") from None


def int_of(s: str) -> int:
    """hyprlock's configStringToInt for plain INT options (booleans, numbers, 0xAARRGGBB)."""
    s = s.strip()
    if s.startswith("0x"):
        return parse_hex(s[2:])
    if s.startswith(("true", "on", "yes")):
        return 1
    if s.startswith(("false", "off", "no")):
        return 0
    if re.fullmatch(r"[+-]?\d+", s):
        return int(s)
    raise ConfError(f"cannot parse {s!r} as an integer")


def parse_color(s: str) -> tuple[int, int, int, int]:
    """(r, g, b, a), unclamped: hyprlock lets out-of-range components spill into their neighbours."""
    s = s.strip()
    if s.startswith("rgba(") and s.endswith(")"):
        inner = s[5:-1].strip()
        if inner.count(",") == 3:
            parts = [p.strip() for p in inner.split(",")]
            r, g, b = (int_of(p) for p in parts[:3])
            return r, g, b, math.floor(c_stof(parts[3]) * 255 + 0.5)
        if len(inner) == 8:
            v = parse_hex(inner)
            return v >> 24 & 255, v >> 16 & 255, v >> 8 & 255, v & 255
        raise ConfError("rgba() expects 8 hex digits or 4 comma separated values")
    if s.startswith("rgb(") and s.endswith(")"):
        inner = s[4:-1].strip()
        if inner.count(",") == 2:
            r, g, b = (int_of(p.strip()) for p in inner.split(","))
            return r, g, b, 255
        if len(inner) == 6:
            v = parse_hex(inner)
            return v >> 16 & 255, v >> 8 & 255, v & 255, 255
        raise ConfError("rgb() expects 6 hex digits or 3 comma separated values")
    v = int_of(s) & 0xFFFFFFFF  # 0xAARRGGBB
    return v >> 16 & 255, v >> 8 & 255, v & 255, v >> 24 & 255


def parse_gradient(s: str) -> tuple[list[tuple[int, int, int, int]], int | None]:
    """Colours and the angle in degrees (None if absent). An empty value has no colours."""
    colors, angle = [], None
    for tok in re.findall(r"rgba?\([^)]*\)|\S+", s):
        if "deg" in tok and not tok.startswith("rgb"):
            angle = c_stoi(tok[: tok.index("deg")])
            break
        if len(colors) >= 10:
            raise ConfError("a gradient takes at most 10 colours")
        colors.append(parse_color(tok))
    return colors, angle


Length = tuple[str, float]  # ("px" | "pct", value)


def parse_layout(s: str) -> tuple[Length, Length]:
    """hyprlock's `x, y` layout value: exactly one comma, each part optionally ending in %."""
    lhs, sep, rhs = s.partition(",")
    if not sep:
        raise ConfError(f"expected two comma separated values, got {s!r}")
    if "," in rhs:
        raise ConfError(f"too many arguments in {s!r}")
    out = []
    for part in (lhs, rhs):
        part = part.strip()
        rel = part.endswith("%")
        out.append(("pct" if rel else "px", c_stof(part[:-1] if rel else part)))
    return out[0], out[1]


# ---- KDL helpers ----

# Bidirectional controls: harmless to the parser, but they reorder how the text around them looks.
BIDI = set("\u061c\u200e\u200f\u202a\u202b\u202c\u202d\u202e\u2066\u2067\u2068\u2069")


def unsafe(c: str) -> bool:
    """A character that must not appear raw in the output: control characters (C0, DEL, C1;
    this covers LF, CR, VT, FF and NEL), U+2028/U+2029, which KDL ends a line on (so in a
    // comment they would start a new node), lone surrogates from undecodable file names, and
    bidi controls."""
    return unicodedata.category(c) in ("Cc", "Zl", "Zp", "Cs") or c in BIDI


def is_surrogate(c: str) -> bool:
    return 0xD800 <= ord(c) <= 0xDFFF


def has_surrogate(s: str) -> bool:
    return any(is_surrogate(c) for c in s)


def escape_unsafe(s: str) -> str:
    """S with every unsafe character as a visible KDL-style \\u{hex} escape. A lone surrogate
    (an undecodable byte of a file name or environment variable, kept by surrogateescape) is
    not a KDL character at all, so it is spelled as plain ASCII text instead: \\xFF for the byte
    0xFF. That is for comments and warnings only; kdl_str never lets one through."""
    out = []
    for c in s:
        o = ord(c)
        if is_surrogate(c):
            out.append(f"\\x{o - 0xDC00:02X}" if 0xDC80 <= o <= 0xDCFF else f"\\u{o:04X}")
        elif unsafe(c):
            out.append(f"\\u{{{o:x}}}")
        else:
            out.append(c)
    return "".join(out)


def comment(text: str) -> str:
    """A single-line KDL comment holding TEXT. Every comment the converter writes goes through
    here: hyprlock text in it must not end the comment and inject KDL."""
    return "// " + escape_unsafe(text)


def kdl_str(s: str) -> str:
    """A KDL string decoding to S. Unsafe characters are \\u{} escapes (same value, but no raw
    line break or control character in the file). KDL cannot hold a lone surrogate, so callers
    refuse such a value before it gets here (path_value does); one that still arrives is
    written as U+FFFD rather than as an escape that makes swaywardlock reject the whole file."""
    s = "".join("\ufffd" if is_surrogate(c) else c for c in s)
    return '"' + escape_unsafe(s.replace("\\", "\\\\").replace('"', '\\"')) + '"'


def fmt(v: float) -> str:
    return str(int(v)) if float(v).is_integer() else repr(round(float(v), 6))


def hexcolor(c: tuple[int, int, int, int]) -> str:
    return kdl_str("#" + "".join(f"{x:02x}" for x in c))


def fmt_len(length: Length) -> str:
    kind, v = length
    return kdl_str(fmt(v) + "%") if kind == "pct" else fmt(v)


# ---- the converter ----


class Scope:
    """The keys of one hyprlock section or widget block, and the KDL lines made from them."""

    def __init__(self, kind: str, prefix: str = "") -> None:
        self.kind = kind
        self.prefix = prefix  # "general:" so a comment names the full hyprlock key
        self.vals: dict[str, tuple[str, str]] = {}  # key -> (value, "file:line")
        self.used: set[str] = set()
        self.lines: list[str] = []  # KDL, from the translators
        self.extra: list[str] = []  # KDL, from UNSUPPORTED handlers that now emit real nodes
        self.comments: list[str] = []
        self.output = ""  # monitor
        self.loc = ""

    def label(self, key: str) -> str:
        return self.prefix + key

    def body(self) -> list[str]:
        return self.lines + self.extra + self.comments


def same_value(value: str, default) -> bool:
    """Is VALUE hyprlock's default (a string, or a number that may be spelled as a bool)?"""
    if isinstance(default, str):
        return value == default
    try:
        return float(int_of(value)) == default
    except ConfError:
        pass
    try:
        return c_stof(value) == default
    except ConfError:
        return False


def unsupported(default=None, why="not supported yet"):
    """A handler for a key with no KDL counterpart: warn and leave a comment, unless VALUE is
    hyprlock's default (which means "off"). A unit that adds the KDL replaces its entry."""

    def handler(conv: "Converter", scope: Scope, key: str, value: str, loc: str) -> None:
        if default is not None and same_value(value, default):
            return
        conv.unsupported(scope, key, value, loc, why)

    return handler


# One entry per hyprlock key that has no KDL yet. Keys the translators consume never get here
# (shadow_size/passes/color on shapes, images and input fields become a `shadow` node, and the
# four shadow keys on a label a `text-shadow` node).
