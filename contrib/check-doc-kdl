#!/usr/bin/env python3
"""Every KDL snippet in the README and the man page must pass `swaywardlock validate`.

Usage: contrib/check-doc-kdl [BINARY]   (default target/debug/swaywardlock)

Checks the fenced blocks of docs/swaywardlock.1.scd and README.md that hold KDL (a block whose
first word is a top-level config node), and the one-line `node { ... }` code spans in the README.
A snippet that does not parse (a missing `;` before `}`) fails the run, as users copy these
straight into their config.
"""
import os
import re
import subprocess
import sys
import tempfile

root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
binary = sys.argv[1] if len(sys.argv) > 1 else os.path.join(root, "target/debug/swaywardlock")

NODES = ("general", "auth", "animations", "background", "label", "image", "shape",
         "input-field", "ring-indicator")
top = re.compile(r"^(?:%s)\b" % "|".join(NODES))


def read(name):
    with open(os.path.join(root, name), encoding="utf-8") as f:
        return f.read()


snippets = []  # (where, text)
for name in ("README.md", "docs/swaywardlock.1.scd"):
    text = read(name)
    for i, block in enumerate(re.findall(r"^```[a-z]*\n(.*?)^```", text, re.M | re.S), 1):
        if top.match(block.lstrip()):
            snippets.append((f"{name} block {i}", block))
# One-line spans: `auth { pam { off; }; }` (README only; the man page's italics are not checked,
# because it shows an invalid line on purpose).
for span in re.findall(r"`([^`\n]+)`", read("README.md")):
    if top.match(span) and "{" in span:
        snippets.append((f"README.md span `{span}`", span))

if len(snippets) < 5:
    sys.exit(f"check-doc-kdl: found only {len(snippets)} snippets; is the pattern stale?")

bad = 0
with tempfile.TemporaryDirectory() as d:
    path = os.path.join(d, "snippet.kdl")
    for where, text in snippets:
        with open(path, "w", encoding="utf-8") as f:
            f.write(text + "\n")
        r = subprocess.run([binary, "validate", "-c", path], capture_output=True, text=True)
        if r.returncode != 0:
            bad += 1
            print(f"check-doc-kdl: {where} does not validate:\n{r.stderr}{r.stdout}", file=sys.stderr)

if bad:
    sys.exit(1)
print(f"check-doc-kdl: ok ({len(snippets)} snippets)")
